// SACLOUD — Prisma 스키마 (Phase 7)
//
// 설계 기준
// 1. `packages/contract`의 Zod 계약이 단일 진실 원천이다. 이 스키마는 그 계약을
//    **채울 수 있는** 형태여야 한다. 계약에 없는 필드를 화면에 노출하지 않는다.
// 2. `CLAUDE.md` 3-A장(마이그레이션 절대 규칙)을 스키마 수준에서 강제한다.
//    - 원본 응답(Raw)을 버리지 않는다        → `RawImport`
//    - 원본 ID를 버리지 않는다               → 각 엔티티의 `source*` 컬럼 + `SourceMapping`
//    - 기존 rating_update를 덮어쓰지 않는다  → `MatchPlayerStat.origin` / `formulaVersion`
//    - 중단 후 재개 가능한 파이프라인        → `ImportJob` / `ImportFailure`
// 3. `docs/LADDER_IMPLEMENTATION_SPEC.md`의 재현성 요구를 반영한다.
//    경기 시점 division 스냅샷과 계산 입력값을 참가자별로 저장한다.
//
// 파생값 저장 정책
//   승률·킬뎃%·경기당킬 같은 **계산 가능한 값은 저장하지 않는다.** 조회 시 계산한다.
//   원본과 어긋날 여지를 없애기 위함이다.
//   예외: `rating`은 랭킹 정렬에 인덱스가 필요해 유지 컬럼으로 둔다(아래 주석 참조).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  /**
   * 운영(Vercel) 런타임용 엔진을 함께 받는다.
   *
   * Vercel 의 서버리스 런타임은 Amazon Linux 라 `rhel-openssl-3.0.x` 엔진이 필요하다.
   * `native` 만 두면 개발 PC(Windows) 엔진만 생기고, 배포하면 런타임에서
   * "could not locate the Query Engine for runtime rhel-openssl-3.0.x" 로 죽는다.
   * 실제로 그렇게 죽었다 (2026-08-27 · D-151).
   *
   * 엔진 파일을 람다 번들에 **복사**하는 것은 별개 문제다 —
   * `apps/web/next.config.ts` 의 `outputFileTracingIncludes` 가 담당한다.
   */
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ========================================================================== */
/* 1. 계정 · 인증                                                              */
/* ========================================================================== */

/// 서비스 회원. 원본은 이메일/비밀번호 단일 방식이며 네이버 메일만 허용한다(관측).
model User {
  id              String    @id @default(cuid())
  /// **로그인 아이디** (2026-09-01 · D-252). 가입은 「아이디 + 비밀번호」다.
  /// 항상 **소문자로 정규화해** 저장한다 — 대소문자만 다른 아이디가 두 개 생기면 안 된다.
  /// 기존(이메일로 가입한) 계정은 `null` 이라 nullable 이다.
  username        String?   @unique
  /// **선택 입력이 됐다** (2026-09-01 · D-252). 메일 발송이 아직 없어서 가입에 요구하지 않는다.
  /// 나중에 비밀번호 찾기를 붙일 때 이 칸을 그대로 쓴다.
  email           String?   @unique
  passwordHash    String
  /// **유일 제약을 걸지 않는다.** 원본이 닉네임 중복을 막는지는 [미확인]이라
  /// 확인되지 않은 제약을 임의로 만들지 않는다 (CLAUDE.md 3장 7번).
  /// 중복 금지가 확인되면 그때 `@unique`로 바꾸고 마이그레이션을 추가한다.
  nickname        String
  avatarUrl       String?
  /// `codes.ts` ROLE: 0 = 일반, 2 = 운영자. 그 외 값의 의미는 [미확인]
  role            Int       @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  playerLink    UserPlayerLink?
  linkClaims    PlayerLinkClaim[]
  /// 칭호 소유권 증명 (2026-09-01) — 게임 칭호를 `[용병]` 으로 바꾸면 승인된다
  titleChallenges TitleChallenge[]
  /// 클랜 마스터 인증 신청 (2026-09-01 · D-253) — 스크린샷 1장을 사람이 본다
  clanMasterClaims ClanMasterClaim[]
  ownedLeagues  League[]
  boards        Board[]
  comments      Comment[]
  authTokens    AuthToken[]
  refreshTokens RefreshToken[]
  uploads       Upload[]

  @@index([createdAt])
  @@index([nickname])
}

/// 서든어택 계정 연동. 연동해야 리그 생성이 가능하다(관측).
/// 원본의 실제 소유권 인증 방식은 [미확인] — 연동 시각만 기록한다.
model UserPlayerLink {
  userId     String   @id
  playerId   String   @unique
  verifiedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

/// 서든어택 계정 **소유권 증명** — 게임 칭호로 한다
/// (`docs/TITLE_VERIFICATION_SPEC.md` + 2026-09-01 정정).
///
/// ── 흐름
///   ① 회원이 자기 서든 닉네임을 넣는다 → 이 표에 `pending` 한 줄
///   ② 게임에서 칭호를 `[용병]` 으로 바꾼다
///   ③ 「확인」 → 넥슨 `user/basic` 1회 → 칭호가 맞으면 `verified`
///
/// ── ⚠ SPEC 과 다른 점
///   SPEC 은 사람마다 **다른 1회용 칭호**를 발급하는 설계였다. 사용자가 **고정
///   `[용병]`** 으로 바꿨다. 그래서 `expectedTitle` 은 항상 같은 값이고
///   `baselineTitle` 은 쓰지 않는다(항상 null). **칸은 지우지 않는다** —
///   1회용 방식으로 되돌릴 때 그대로 쓴다 (CLAUDE.md 10-4).
///
/// ── 기준은 `ouid` 다 (D-220)
///   닉네임으로 잇지 않는다. 닉은 식별자가 아니고 옛 닉은 남이 물려받는다.
///   `nickname` 은 **신청 당시 무엇을 넣었는지**를 남기는 증거일 뿐 판정 기준이 아니다.
model TitleChallenge {
  id String @id @default(cuid())

  /// 도전을 연 사람
  userId String
  /// 인증하려는 계정. **판정의 유일한 기준이다**
  ouid   String
  /// 신청 당시 넣은 닉네임 (증거. 판정 기준이 아니다)
  nickname String?

  /// 우리가 요구한 칭호. 지금은 항상 `[용병]` 이다
  expectedTitle String
  /// 1회용 방식에서 쓰던 칸 — 발급 시점의 칭호. 고정 칭호 방식에서는 항상 null
  baselineTitle String?

  /// "pending" | "verified" | "expired" | "exhausted" | "cancelled"
  /// **읽을 때 시각으로 다시 계산한다** — 만료는 아무도 표를 고쳐 주지 않는다
  status String @default("pending")

  issuedAt  DateTime @default(now())
  expiresAt DateTime

  /// 확인 시도 횟수. 넥슨 API 를 무한히 두드리지 않는다
  attempts      Int       @default(0)
  lastCheckedAt DateTime?
  /// 마지막으로 관측한 칭호. 넥슨이 안 주면 null(`알수없음`).
  /// **인증의 근거로 남는 값이다** — 나중에 다툼이 생기면 이걸 본다
  lastSeenTitle String?

  verifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([userId])
  @@index([ouid])
}

/// 서든어택 계정 연동 **신청** (D-121).
///
/// 넥슨 Open API에는 사용자가 계정 소유를 증명할 수단이 없다 —
/// 엔드포인트가 전부 닉네임으로 조회하는 **공개 정보**이고, OAuth도 동의 흐름도 없다.
/// 그래서 "닉네임을 아는 사람이 곧 주인"이 되는 자동 연결을 폐기하고,
/// **운영자가 근거를 보고 승인**하는 구조로 바꿨다.
///
/// 없는 증명을 흉내 내지 않는다. 확인할 수 없으면 확인했다고 하지 않는다.
model PlayerLinkClaim {
  id       String @id @default(cuid())
  userId   String
  playerId String

  /// "pending" | "approved" | "rejected" | "cancelled"
  status   String @default("pending")
  /// 신청자가 적은 근거 (클랜 동료 확인·스크린샷 위치 등). 운영자가 읽고 판단한다
  evidence String?

  createdAt DateTime @default(now())
  /// 처리 시각·처리자. 계정이 지워져도 이력은 남기려고 FK를 걸지 않는다
  decidedAt        DateTime?
  decidedByUserId  String?
  decidedByEmail   String?
  decisionNote     String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// 같은 사람이 같은 선수를 중복 신청하지 않는다
  @@unique([userId, playerId])
  @@index([status, createdAt])
  @@index([playerId, status])
}

/// 클랜 **마스터 인증** 신청 (2026-09-01 · D-253).
///
/// ── 사용자 지시
///   *"클랜설정은 마스터한테 권한을 준다 (…) 인증하기 방법은 그냥 마스터 계정으로 접속한
///    인게임 사진 하나 첨부하라고 하면 끝이다."*
///
/// ── ⚠ 선수 칭호 인증(`TitleChallenge`)과 무엇이 다른가
///   칭호 인증은 넥슨이 칭호를 그대로 줘서 **기계가 판정한다.**
///   마스터 인증은 넥슨이 「이 계정이 그 클랜의 마스터인가」를 알려 주지 않는다.
///   그래서 **사람이 사진을 보고 판정한다** — `PlayerLinkClaim`(D-121)과 같은 태도다.
///   확인할 수 없는 것을 확인했다고 하지 않는다.
///
/// ── 승인된 줄 자체가 권한이다
///   별도의 `ClanMasterGrant` 표를 만들지 않았다. `status='approved'` 한 줄이 곧 권한이고,
///   `lib/server/ownership.ts` 의 `requireClanOwner` 가 그것만 본다.
///   되돌리기는 `status='revoked'` 로 한다 — **행을 지우지 않는다.** 심사 이력이 근거다.
model ClanMasterClaim {
  id String @id @default(cuid())

  /// 신청한 회원
  userId String
  /// 마스터라고 주장하는 클랜
  clanId String

  /// "pending" | "approved" | "rejected" | "cancelled" | "revoked"
  /// `revoked` 는 **승인됐던 흔적**이지 권한이 아니다
  status String @default("pending")

  /// 신청자가 관리자에게 남긴 한 줄 (선택)
  note String?

  createdAt DateTime @default(now())

  /// 처리 시각·처리자. 계정이 지워져도 이력은 남기려고 FK를 걸지 않는다 (`PlayerLinkClaim` 과 같다)
  decidedAt       DateTime?
  decidedByUserId String?
  decidedByEmail  String?
  /// 거부 사유. **화면이 신청자에게 그대로 보여 준다** — 왜 거부됐는지 모르면 다시 낼 수 없다
  decisionNote    String?

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clan  Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  image ClanMasterClaimImage?

  /// 같은 사람이 같은 클랜을 중복 신청하지 않는다. 다시 내면 이 행을 되살린다
  @@unique([userId, clanId])
  @@index([status, createdAt])
  @@index([clanId, status])
}

/// 마스터 인증 스크린샷 **원본 바이트**.
///
/// ── ⚠ 왜 DB 에 넣는가
///   오브젝트 스토리지가 아직 없다 (CLAUDE.md 8장 「Phase 7에서 남긴 숙제」).
///   기존 `/api/uploads` 는 `public/uploads/` 에 파일로 쓰는데, **운영에서는 스스로를 막는다**
///   (D-147 — 서버리스 파일시스템은 읽기 전용이라 503 을 돌려준다).
///   즉 **지금 운영에서 동작하는 업로드 경로가 없다.** 그래서 가장 작은 해법을 골랐다 —
///   3MB 상한을 걸고 바이트를 그대로 넣는다 (D-253).
///
/// ── ⚠ 왜 `ClanMasterClaim` 과 다른 표인가
///   같은 표에 두면 `findMany()` 한 번이 수십 MB 를 끌어온다. Prisma 는 **관계를 기본으로
///   따라가지 않으므로**, 표를 나누는 것만으로 그 실수가 구조적으로 불가능해진다.
///
/// 오브젝트 스토리지가 붙으면 이 표를 비우고 URL 만 남기면 된다.
model ClanMasterClaimImage {
  claimId String @id

  /// "image/png" | "image/jpeg" | "image/webp" — 계약이 정한 목록만 들어온다
  mimeType String
  byteSize Int
  /// 원본 바이트. **가공하지 않는다** — 사람이 눈으로 볼 유일한 근거다
  data     Bytes

  createdAt DateTime @default(now())

  claim ClanMasterClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

/// 이메일 인증 / 비밀번호 재설정 토큰. 평문을 저장하지 않고 해시만 보관한다.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  /// "email_verify" | "password_reset"
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// 리프레시 토큰. 계약의 `AuthSession.refresh_token`에 대응한다.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/* ========================================================================== */
/* 2. 도메인 — 플레이어 · 클랜                                                  */
/* ========================================================================== */

/// 서든어택 플레이어. 리그와 무관한 전역 엔티티다.
model Player {
  id        String    @id @default(cuid())
  name      String
  clanId    String?
  /// 클랜 내 포지션 메모 (예: "2층")
  position  String?
  /// 플레이어 소개/메모 (원본 `note`)
  note      String?
  /// 마지막 `정보갱신` 시각
  renewedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /* --- 원본 대조용. 버리지 않는다 (CLAUDE.md 3-A 3번) --- */
  /// 3rd.supply의 플레이어 ID
  sourcePlayerId String?
  /// 넥슨 계정 식별자(ouid) **비권위 캐시**.
  /// 넥슨이 ouid 변경 가능성을 명시했으므로 이 값을 영구 동일인 판단 근거로 쓰지 않는다.
  /// 권위 있는 매핑은 `NexonIdentity`에 있다 (D-036).
  nexonOuid      String?
  /// "sacloud" | "nexon" | "3rd.supply" | "mock" — 이 행이 어디서 왔는가 (D-116).
  /// `mock`은 개발용 시드다. **공개 화면에 내보내지 않는다.**
  origin         String  @default("sacloud")

  clan          Clan?           @relation("ClanMembers", fields: [clanId], references: [id], onDelete: SetNull)
  masterOf      Clan[]          @relation("ClanMaster")
  userLink      UserPlayerLink?
  linkClaims    PlayerLinkClaim[]
  leaguePlayers LeaguePlayer[]
  matchStats    MatchPlayerStat[]
  mvpMatches    Match[]         @relation("MatchMvp")
  nexonIdentities         NexonIdentity[]
  nexonIdentityCandidates NexonIdentityCandidate[]
  rosterMemberships       LeagueRosterMembership[]
  weaponEvidence          MatchWeaponEvidence[]
  positionProfiles        PlayerPositionProfile[]
  roundProfiles           PlayerRoundProfile[]
  playstyleProfiles       PlayerPlaystyleProfile[]

  @@unique([sourcePlayerId])
  @@unique([nexonOuid])
  @@index([name])
  @@index([clanId])
  @@index([origin])
}

/// 클랜. 원본은 넥슨 병영수첩 slug를 그대로 식별자로 쓴다(관측).
model Clan {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  /// 클랜마크 2레이어. 원본 이미지를 복사하지 않고 URL만 보관한다.
  markBgUrl      String?
  markFrontUrl   String?
  masterPlayerId String?
  notice         String?
  establishedAt  DateTime? @db.Date
  /// 마지막 `전적갱신` 시각
  renewedAt      DateTime?
  /// 클랜 설정 — 리그 초대 차단
  blockInvitation Boolean  @default(false)

  /* --- 운영 구분 (Phase 10) --- */
  /// "official" = 공식리그 참여 클랜 | "independent" = 무소속
  category   String  @default("official")
  /// 무소속 클랜의 티어 1~6 (D-181 로 5 → 6). **자동 승강하지 않는다.** 운영자가 직접 정한다
  /// 상한의 단일 출처는 `packages/db/ops/independentLeague.ts` 의 `INDEPENDENT_TIER_COUNT` 다
  /// — 숫자를 여기저기 박지 마라. 이 주석은 설명일 뿐 검사는 `updateClan()` 이 한다
  tier       Int?
  /// 비활성 클랜은 랭킹·목록에서 감춘다. **삭제 대신 이 값을 쓴다**
  active     Boolean @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// 3rd.supply의 클랜 ID
  sourceClanId String?
  /// "sacloud" | "nexon" | "3rd.supply" | "mock" — 이 행이 어디서 왔는가 (D-116).
  /// `mock`은 개발용 시드다. **공개 화면에 내보내지 않는다.**
  origin       String  @default("sacloud")

  master        Player?        @relation("ClanMaster", fields: [masterPlayerId], references: [id], onDelete: SetNull)
  members       Player[]       @relation("ClanMembers")
  leagueClans   LeagueClan[]
  leaguePlayers LeaguePlayer[] @relation("LeaguePlayerClan")
  invitations LeagueInvitation[]
  aliases     ClanAlias[]
  masterClaims ClanMasterClaim[]

  @@unique([sourceClanId])
  @@index([name])
  @@index([origin])
  barracksNumbers BarracksClanNumber[]
}

/// 클랜의 다른 표기 (Phase 10).
///
/// 넥슨 상세가 주는 `guild_name`이 우리 클랜명과 글자가 다를 수 있다.
/// **비슷하다고 자동으로 묶지 않는다** (D-088). 운영자가 등록한 별칭만 인정한다.
model ClanAlias {
  id        String   @id @default(cuid())
  clanId    String
  /// 넥슨 `guild_name` 등 외부 표기. 대소문자·공백까지 그대로 둔다
  alias     String   @unique
  /// "nexon_guild" | "manual" — 어디서 온 표기인가
  source    String   @default("manual")
  createdAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

/// 운영자 변경 이력 (Phase 10).
///
/// 누가·언제·무엇을·이전 값·바뀐 값을 남긴다. **되돌릴 수 있어야 하기 때문이다.**
model AdminAuditLog {
  id         String   @id @default(cuid())
  /// 실행한 운영자 (계정이 지워져도 이력은 남기려고 FK를 걸지 않는다)
  userId     String
  userEmail  String
  /// "season.close" | "clan.update" | "roster.add" | "match.official" 등
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/// 운영 설정 (Phase 10).
///
/// 베타오픈 시각처럼 **운영자가 나중에 정하는 값**을 코드에 박지 않기 위한 저장소다.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/* ========================================================================== */
/* 3. 리그 · 시즌                                                              */
/* ========================================================================== */

/// 리그맵. 실제 맵 목록은 원본 조사 범위 밖이라 [미확인].
model GameMap {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  leagues LeagueMap[]
  matches Match[]
}

model League {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  /// 리그소개 HTML. **저장 전 서버에서 새니타이즈한다.**
  description   String?
  ownerUserId   String?
  /// 1 = 단일리그, 2 이상 = N부리그
  divisionCount Int      @default(1)
  /// 값 체계 [미확인] — 관측된 정상 리그는 1
  status        Int      @default(1)
  /// 공식 리그 배지. 원본 필드명은 [미확인] — 우리 계약에서 `official`로 확정
  official      Boolean  @default(false)
  /// "official" = 공식리그 | "independent" = 무소속리그 (D-107)
  ///
  /// 개인 기록은 이미 `LeaguePlayer(leagueId, playerId)` 단위로 완전히 분리돼 있다.
  /// 그래서 무소속리그는 **별도 League 행**이고, 두 리그의 rating·승패·랭킹·시즌 카드는
  /// 구조적으로 섞일 수 없다. 이 컬럼이 정하는 것은 **공개 범위 하나**다 —
  /// 무소속리그에서는 누적 kill/death/킬뎃을 사용자 화면에 내보내지 않는다.
  /// 경기 한 판의 K/D/A는 숨기지 않는다.
  category      String   @default("official")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// 3rd.supply의 리그 ID
  sourceLeagueId String?
  /// "sacloud" | "3rd.supply" | "mock" — 이 행이 어디서 왔는가 (D-116).
  /// `mock`은 개발용 시드다. **공개 화면에 내보내지 않는다.**
  origin        String   @default("sacloud")

  owner        User?               @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  maps         LeagueMap[]
  playerLimits LeaguePlayerLimit[]
  clans        LeagueClan[]
  players      LeaguePlayer[]
  seasons      Season[]
  matches      Match[]
  invitations  LeagueInvitation[]
  rankSnapshots RankSnapshot[]
  ratingConfigs RatingConfig[]
  rosterMemberships LeagueRosterMembership[]
  /// 클랜 육각형 V2 의 접어 둔 사본 — **리그 백분위 모집단이 여기서 나온다** (D-238 후속)
  clanHexV2Summaries ClanHexV2Summary[]

  @@unique([sourceLeagueId])
  @@index([official, createdAt])
  @@index([origin])
}

/// 리그가 기록 대상으로 삼는 맵. 여기 없는 맵의 경기는 저장하지 않는다.
model LeagueMap {
  leagueId String
  mapId    String

  league League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  map    GameMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([leagueId, mapId])
}

/// 리그가 기록 대상으로 삼는 대전 인원 (5 또는 6).
model LeaguePlayerLimit {
  leagueId    String
  playerCount Int

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([leagueId, playerCount])
}

/// 시즌.
///
/// 사용자에게 보이는 흐름은 하나로 이어진다 (D-098):
///   Season 1 … Season 7 → Beta Season → Season 8 …
///
/// 세 종류를 `seasonType`으로 구분한다.
///   `legacy`   3rd.supply에서 이전된 과거 기록. **재계산하지 않는다**
///   `beta`     공개 베타 시즌. 기록은 보여 주되 다음 정식 시즌에 승계하지 않는다
///   `official` SACLOUD 정식 시즌
model Season {
  id        String    @id @default(cuid())
  leagueId  String
  /// 표시용 시즌 번호. **베타는 `0`이고 화면에 숫자로 쓰지 않는다** (`Beta Season`으로 표기)
  number    Int
  startedAt DateTime
  endedAt   DateTime?
  /// "active" | "closed"
  status    String    @default("active")
  /// "legacy" | "beta" | "official"
  seasonType String   @default("official")
  /// 이 시즌 기록이 3rd.supply에서 이전된 것인지
  imported  Boolean   @default(false)
  /// 확정된 과거 기록인가. `true`면 수집·래더 재계산이 이 시즌의 값을 건드리지 못한다
  frozen    Boolean   @default(false)
  createdAt DateTime  @default(now())

  league       League              @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerStats  LeaguePlayerSeason[]
  clanStats    LeagueClanSeason[]
  matches      Match[]
  rosterMemberships LeagueRosterMembership[]

  @@unique([leagueId, number])
  @@index([leagueId, number])
  // 화면 정렬은 번호가 아니라 **시작 시각** 기준이다. 베타(number 0)가 7과 8 사이에 와야 한다
  @@index([leagueId, startedAt])
}

/// 리그에 참여한 클랜. 래더·부리그·전적을 보유한다.
model LeagueClan {
  id       String @id @default(cuid())
  leagueId String
  clanId   String

  /// **표시 점수** — 화면·랭킹 정렬에 쓰는 값 (D-145).
  /// `internalRating` 에서 구성 보정을 더하고 활동 페널티를 뺀 정수다.
  rating   Int    @default(3000)
  /// **내부 Elo** — 실력 추정치 (D-145). 실수로 유지한다.
  /// 경기마다 반올림하면 제로섬이 깨진다.
  internalRating Float @default(3000)
  /// 최근 N경기 평균 본클랜원 수에서 나온 구성 보정 (상한 +50)
  compositionScore Float @default(0)
  /// 최근 20경기 평균 본클랜원 수 — compositionScore 의 입력값 (D-149).
  /// 화면은 이 값을 그대로 보여 준다. UI 에서 다시 계산하지 않는다.
  compositionMembers Float @default(0)
  /// 미참여로 쌓인 활동 페널티. **내부 Elo 는 건드리지 않는다**
  activityPenalty  Float @default(0)
  /// 마지막 래더 대상 경기 시각 — 미참여 일수 계산에 쓴다
  lastRatedAt      DateTime?
  /// 1 = 1부리그
  division Int    @default(1)
  win      Int    @default(0)
  lose     Int    @default(0)

  /// 배치고사 진행 중이면 true — 랭킹 미표시, 래더 자리에 `배치고사` 표기
  placement       Boolean @default(true)
  /// 배치고사로 치른 경기 수
  placementPlayed Int     @default(0)

  /// 0 = 대기/배치, 1 = 정상 (관측값). 그 외 코드는 [미확인]
  status           Int       @default(0)
  joinedAt         DateTime  @default(now())
  /// 클랜삭제 요청 시각. 1주일 뒤 자동 삭제(관측)
  deleteRequestedAt DateTime?
  deletesAt        DateTime?
  /// 추방 시각. 되돌릴 수 없고 재가입 불가(관측)
  expelledAt       DateTime?
  updatedAt        DateTime  @updatedAt

  /// 3rd.supply의 league_clan ID
  sourceLeagueClanId String?

  league       League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  clan         Clan               @relation(fields: [clanId], references: [id], onDelete: Cascade)
  seasonStats  LeagueClanSeason[]
  redMatches   Match[]            @relation("MatchRedClan")
  blueMatches  Match[]            @relation("MatchBlueClan")
  rosterMemberships LeagueRosterMembership[]
  roundProfiles ClanRoundProfile[]
  /// 클랜 육각형 V2 — 경기 단위 원재료. 클랜 값은 이 행들의 **합**이다 (D-235)
  clanHexV2 MatchClanHexV2[]
  /// 위 행들을 **미리 접어 둔 사본** (D-238 후속). 원재료가 아니라 사본이다
  clanHexV2Summary ClanHexV2Summary?

  @@unique([leagueId, clanId])
  @@unique([sourceLeagueClanId])
  // 클랜랭킹: 부리그별 래더 내림차순
  @@index([leagueId, division, rating(sort: Desc)])
}

/// 리그에 참여한 플레이어. 개인 래더와 누적 스탯을 보유한다.
model LeaguePlayer {
  id       String  @id @default(cuid())
  leagueId String
  playerId String
  /// 경기 당시가 아니라 **현재** 소속 클랜 (표시용)
  clanId   String?

  /// 통합 래더 = baseRating + 무기별 ratingDelta 합.
  /// 무기 분리가 통합 래더 값을 바꾸면 안 된다 (LADDER_IMPLEMENTATION_SPEC 6장).
  /// 정렬 인덱스 때문에 유지 컬럼으로 두되, 정합성 검사를 테스트로 고정한다.
  /// **표시 점수** — 화면·랭킹 정렬에 쓰는 값 (D-145).
  /// `3000 + (internalRating − 3000) × 신뢰도 × 3.5` 에 승률 자격선과 활동 페널티를 적용한 정수다.
  rating      Int @default(3000)
  /// 배치고사 종료 시점의 시작 래더. 이후 증감은 무기별 delta에 누적된다.
  baseRating  Int @default(3000)
  /// **내부 Elo** — 실력 추정치 (D-145). 실수로 유지한다.
  /// 표시 점수와 달리 신뢰도·자격선·미참여 감점의 영향을 받지 않는다.
  internalRating Float @default(3000)
  /// 미참여로 쌓인 활동 페널티. 표시 점수에서만 뺀다
  activityPenalty Float @default(0)
  /// 마지막 래더 대상 경기 시각
  lastRatedAt     DateTime?

  win      Int @default(0)
  lose     Int @default(0)
  kill     Int @default(0)
  death    Int @default(0)
  assist   Int @default(0)
  headshot Int @default(0)
  mvpCount Int @default(0)

  placement       Boolean @default(true)
  placementPlayed Int     @default(0)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 3rd.supply의 league_player ID
  sourceLeaguePlayerId String?

  league      League                   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player      Player                   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clan        Clan?                    @relation("LeaguePlayerClan", fields: [clanId], references: [id], onDelete: SetNull)
  weaponStats LeaguePlayerWeaponStat[]
  seasonStats LeaguePlayerSeason[]

  @@unique([leagueId, playerId])
  @@unique([sourceLeaguePlayerId])
  // 개인랭킹: 래더 내림차순
  @@index([leagueId, rating(sort: Desc)])
}

/// 무기별 분리 기록 (0 = 라이플, 1 = 스나이퍼).
///
/// `LADDER_IMPLEMENTATION_SPEC` 6장: `rating_update`는 무기와 무관하게 한 공식으로 계산하고,
/// 그 값을 **해당 경기에서 쓴 무기 쪽 delta에만** 누적한다.
/// 화면에는 무기별로 kills·deaths·KD%·wins·losses·win%·rating delta·weapon rank를 보여준다.
model LeaguePlayerWeaponStat {
  leaguePlayerId String
  /// 0 = 라이플, 1 = 스나이퍼
  weapon         Int

  ratingDelta Int @default(0)
  /// 그 무기로 뛴 경기 전부 (KDA 를 모르는 경기 포함)
  games          Int @default(0)
  /// 그중 K/D/A 를 아는 경기. 킬·데스·어시의 **분모**다 (D-149)
  knownStatGames Int @default(0)
  win         Int @default(0)
  lose        Int @default(0)
  kill        Int @default(0)
  death       Int @default(0)
  assist      Int @default(0)
  headshot    Int @default(0)

  /// **주무기인가** (D-173). 그 무기로 뛴 판수가 전체의 절반 이상이면 참이다.
  ///
  /// 무기 랭킹의 모집단이다 — 스나 랭킹에는 스나수만 올린다.
  /// 이게 없으면 라플수가 어쩌다 든 스나 몇 판으로 스나 랭킹에 들어온다.
  /// 기록 자체(판수·킬데스·증감)는 주무기가 아니어도 그대로 남는다.
  isMain Boolean @default(false)

  updatedAt DateTime @updatedAt

  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@id([leaguePlayerId, weapon])
  @@index([weapon, ratingDelta(sort: Desc)])
  @@index([weapon, isMain, ratingDelta(sort: Desc)])
}

/* -------------------------- 시즌 스냅샷 (지난시즌) -------------------------- */

/// 시즌 종료 시점에 고정되는 개인 성적. **hard delete 금지** (CLAUDE.md 3-A 7번).
model LeaguePlayerSeason {
  id             String @id @default(cuid())
  leaguePlayerId String
  seasonId       String
  /// 조회 편의를 위한 비정규화. `Season.number`와 항상 같아야 한다.
  season         Int

  rank      Int?
  rankCount Int?

  /* SACLOUD가 계산한 시즌 카드는 이 값들이 **항상 있다**.
     과거(3rd.supply) 카드는 시즌마다 제공 필드가 달라서 **없을 수 있다** — 예를 들어
     시즌 4는 승률·킬뎃만 주고 승/패/킬/데스를 주지 않는다.
     그때 0을 넣으면 화면에 `0승 0패 · 승률 56.9%` 같은 **거짓말**이 남는다.
     그래서 nullable이다. 없으면 `null`, 화면에는 `알수없음` (D-106). */
  rating    Int?
  win       Int?
  lose      Int?
  kill      Int?
  death     Int?

  /* 아래는 **원본에 있을 때만** 채운다. 없으면 `null`로 남긴다 — 역산하지 않는다 (D-099).
     승률·킬뎃은 승패·킬데스로 계산할 수 있지만, 원본이 준 값과 반올림이 달라질 수 있어
     원본 값을 그대로 보존한다. */
  assist       Int?
  headshot     Int?
  winRate      Float?
  kdRate       Float?
  /// 평균킬 (원본 `kill_per_match`)
  killPerMatch Float?
  mvpCount     Int?
  /// 그 시즌 시점의 소속·부리그·닉네임. 지금 값이 아니라 **그때의 값**이다
  clanNameAtSeason String?
  divisionAtSeason Int?
  nicknameAtSeason String?
  /// 3rd.supply 쪽 식별자. 닉네임 자동 병합을 하지 않기 위한 근거로 보존한다 (D-100)
  legacyPlayerId       String?
  legacyLeaguePlayerId String?
  /// 어디서 왔는지 ("3rd.supply" 등). SACLOUD가 계산한 행은 `null`
  source    String?

  /// 이 행이 3rd.supply에서 이전된 것인지. true면 값을 재계산하지 않는다.
  imported  Boolean  @default(false)
  createdAt DateTime @default(now())

  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)
  seasonRef    Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([leaguePlayerId, seasonId])
  @@index([seasonId, rating(sort: Desc)])
}

/// 시즌 종료 시점에 고정되는 클랜 성적.
/// 개인과 컬럼 구성이 다른지는 [미확인] — 계약상 동일 형태로 둔다.
model LeagueClanSeason {
  id           String @id @default(cuid())
  leagueClanId String
  seasonId     String
  season       Int

  rank      Int?
  rankCount Int?
  rating    Int
  division  Int @default(1)
  win       Int @default(0)
  lose      Int @default(0)

  /* 원본에 있을 때만 채운다 (D-099) */
  winRate           Float?
  clanNameAtSeason  String?
  legacyClanSlug    String?
  source            String?

  imported  Boolean  @default(false)
  createdAt DateTime @default(now())

  leagueClan LeagueClan @relation(fields: [leagueClanId], references: [id], onDelete: Cascade)
  seasonRef  Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([leagueClanId, seasonId])
  @@index([seasonId, division, rating(sort: Desc)])
}

/// 리그 관리 — 클랜 초대. 초대링크 복사에 사용한다(관측).
model LeagueInvitation {
  id        String    @id @default(cuid())
  leagueId  String
  clanId    String
  division  Int       @default(1)
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  acceptedAt DateTime?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
}

/* ========================================================================== */
/* 4. 매치 · 스탯                                                              */
/* ========================================================================== */

/// 한 경기.
///
/// 매치 ID는 원본 관측 규칙(`YYMMDDHHmmss` + 6자리, 총 18자리)을 그대로 쓴다.
/// 승패·래더증감은 **보는 쪽에 따라 달라지므로** 여기 저장하지 않고
/// 진영별 스냅샷에서 조회 시 계산한다.
model Match {
  /// 18자리 숫자 문자열
  id          String   @id
  leagueId    String
  seasonId    String?
  mapId       String
  playerCount Int
  startAt     DateTime
  /// 원본이 종료 시각을 주지 않으면 null (넥슨은 date_match 하나뿐) — D-034
  endAt       DateTime?
  /// 플레이 시간(초). endAt-startAt과 다를 수 있어 원본값을 그대로 보관한다.
  /// 원본에 없으면 null = 알 수 없음 (D-034)
  playTime    Int?

  /// **폐기됐다 (D-207).** 읽지 마라 — 화면도 API 도 더 이상 보지 않는다.
  ///
  /// 뜻이 `[미확인]` 인 채로 남아 있던 칸이다. 실제로 값이 든 것은 mock 시드뿐이고
  /// (`project`·`reconstruct`·`supplyMirrorImport` 는 전부 null 을 넣는다) 그 mock 값도
  /// 난수였다. 전반 공수는 아래 `firstHalfAttackSide` 가 **근거로** 정한다.
  /// 열은 지우지 않는다 — 과거 행의 값을 없애지 않기 위해서다.
  blueFirst   Boolean?

  /// **전반에 레드진영(공격)을 맡은 쪽** — `"red"` | `"blue"` (D-207).
  ///
  /// 값은 우리 슬롯 이름이다. `"red"` 면 `redLeagueClanId` 클랜이 전반 공격(= `선레드`)이고
  /// `blueLeagueClanId` 클랜이 `선블루` 다. `"blue"` 면 정반대다.
  ///
  /// ── 슬롯 이름을 그대로 진영으로 읽으면 안 된다
  ///   red/blue 슬롯은 수집 시 `team_id` 오름차순으로 정한 **내부 자리**다
  ///   (`assignSides()`). 실측 3,750경기 중 3,745경기(99.87%)에서 `redLeagueClanId` 쪽이
  ///   **전반 수비**였다. 그래서 슬롯 이름으로 `선레드` 를 적던 화면이 뒤집혀 있었다.
  ///   **슬롯 배정은 바꾸지 않는다** — 래더·집계 전체가 그 값을 쓴다. 표기만 여기서 만든다.
  ///
  /// ── 근거가 없으면 null 이다
  ///   `team_id` 순서를 후퇴값으로 쓰지 않는다. 반례 5건(0.13%)이 실재한다.
  firstHalfAttackSide String?
  /// 위 값을 무엇이 정했나 — `"barracks_bomb"`(병영수첩 배틀로그 C4 설치/해체 · D-184).
  /// 근거가 없으면 null. 추측한 값을 여기에 적지 않는다.
  firstSideEvidence   String?
  /// "red" | "blue"
  winnerSide  String
  mvpPlayerId String?

  redLeagueClanId  String
  blueLeagueClanId String

  /* --- 경기 시점 스냅샷. 승격·강등 후에도 과거 경기가 오염되면 안 된다 --- */
  /// LADDER_IMPLEMENTATION_SPEC 4장 — 필수
  redDivisionAtMatch  Int
  blueDivisionAtMatch Int
  redRatingBefore     Int?
  blueRatingBefore    Int?
  redPlacement        Boolean @default(false)
  bluePlacement       Boolean @default(false)
  /// 클랜 래더 증감 (진영별). 배치고사면 0.
  redRatingUpdate     Int?
  blueRatingUpdate    Int?

  /* 원본(3rd.supply)이 보여 준 클랜 점수 — 위 값과 분리한다 (D-153).
     위는 우리가 계산한 값이고, 아래는 원본이 그 경기에 실제로 보여 준 값이다. */
  redSourceRating       Int?
  blueSourceRating      Int?
  redSourceRatingUpdate  Int?
  blueSourceRatingUpdate Int?

  /* --- 출처 추적 --- */
  /// "3rd.supply" | "nexon" | "sacloud" | "mock"
  /// `mock`은 개발용 시드 데이터다. 실제 기록과 섞이지 않게 출처를 남긴다.
  origin       String   @default("sacloud")
  sourceMatchId String?

  /// **공식 통계 반영 대상인가** (Phase 9 · D-079 · D-080).
  ///
  /// `false`면 **참고 기록**이다 — 기록실에는 그대로 보이지만
  /// 시즌 승패·킬뎃·평균킬·MVP·개인 래더·클랜 래더·랭킹에 **전혀 반영하지 않는다.**
  /// 양 팀 모두 본클랜원이 3명 미만인 경기가 여기 해당한다. **경기를 지우지는 않는다.**
  official     Boolean @default(true)

  /// 재구성으로 만든 경기의 **확인 수준** (Phase 9 · D-068).
  /// "5v4" 처럼 몇 명을 확인했는지, 그리고 그 확신 등급을 화면에 그대로 보여 준다.
  /// 우리가 모르는 것을 아는 척하지 않기 위한 값이다.
  participantCompleteness String?
  /// "high" | "medium" | "low"
  evidenceConfidence      String?
  ingestedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  league    League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season    Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  map       GameMap     @relation(fields: [mapId], references: [id])
  redClan   LeagueClan  @relation("MatchRedClan", fields: [redLeagueClanId], references: [id], onDelete: Cascade)
  blueClan  LeagueClan  @relation("MatchBlueClan", fields: [blueLeagueClanId], references: [id], onDelete: Cascade)
  mvpPlayer Player?     @relation("MatchMvp", fields: [mvpPlayerId], references: [id], onDelete: SetNull)
  stats     MatchPlayerStat[]
  /// 클랜 육각형 V2 — 경기 한 건에 **양쪽 클랜 두 행**이 붙는다 (D-235)
  clanHexV2 MatchClanHexV2[]

  /**
   * 같은 경기가 **여러 리그에 기록될 수 있다** (D-155).
   *
   * 클랜은 리그를 겸한다. e2stro- 와 The|vub 가 둘 다 공식리그·열산리그 소속이면
   * 그 경기는 **양쪽 리그에 다 찍혀야 한다.** 예전 제약 `unique(origin, sourceMatchId)` 은
   * 한 경기를 한 리그에만 묶어서, 먼저 들어간 리그에만 남고 나머지는 버려졌다 —
   * 실측으로 공식리그 1,828건 · 열산리그 28건이 그렇게 스킵됐다.
   *
   * 리그마다 **값이 다르다.** 부리그(`redDivisionAtMatch`)·클랜 래더·증감은 리그별이다.
   * 그래서 한 행을 공유할 수 없고 리그마다 행을 둔다. 같은 물리 경기가 여러 행이 되지만
   * 그 둘은 서로 다른 리그 기록이다.
   *
   * `id` 는 리그별로 다르게 만들고(`<matchId>@<leagueSlug>`), 실제 경기 번호는
   * `sourceMatchId` 에 그대로 남는다 — 원본 대조 키를 잃지 않는다 (3-A 3번).
   */
  @@unique([leagueId, origin, sourceMatchId])
  // 기록실: 리그별 최신순
  @@index([leagueId, startAt(sort: Desc)])
  @@index([redLeagueClanId, startAt(sort: Desc)])
  @@index([blueLeagueClanId, startAt(sort: Desc)])
  @@index([seasonId])
}

/// 경기 참가자 한 명의 기록 + 래더 계산 재현 정보.
///
/// 결측 처리: 상대 클랜 소속 플레이어는 딜량·헤드샷을 알 수 없다.
/// **추측해서 채우지 않고 `null`로 저장**하고 UI에서 `알수없음`으로 표기한다.
model MatchPlayerStat {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  /// "red" | "blue"
  side     String

  kill     Int?
  death    Int?
  assist   Int?
  /// 결측 가능 — `알수없음`
  headshot Int?
  /// 결측 가능 — `알수없음`
  damage   Int?
  /// 0 = 라이플, 1 = 스나이퍼 (라인업에 `[S]` 표기).
  /// 넥슨 Open API는 무기를 주지 않는다 → null = 알 수 없음 (D-034)
  weapon   Int?
  /// 탈주. **모르면 null이다.** false는 "탈주하지 않았다"는 실제 정보다 (D-034)
  dropout  Boolean?
  /// MVP. 위와 같다 — 모르면 null (D-034)
  mvp      Boolean?

  /// 이 경기에서의 역할 — "member"(본클랜원) | "mercenary"(용병) (Phase 9 · D-073).
  /// 용병도 개인 기록과 개인 래더를 정상적으로 받는다.
  /// 공식전 인정(양 팀 본클랜원 3명)에만 쓰이지 않을 뿐이다.
  participantRole String @default("member")
  /// 경기 시점 **원소속 클랜**. 용병이면 뛴 팀과 다르고, 없으면 null.
  /// **이 클랜의 래더는 이 경기로 변하지 않는다** (D-075)
  rosterLeagueClanId String?

  /* --- 경기 당시 소속 스냅샷 (D-131) ---------------------------------------
     기록실·경기 상세는 **그 경기를 했을 당시** 소속을 보여 준다.
     현재 소속(`Player.clanId` / `LeaguePlayer.clanId`)을 join 해서 과거 화면에
     뿌리면 선수가 이적하는 순간 과거 기록이 통째로 바뀐다. 그래서 값을 박아 둔다.
     리그 밖 클랜일 수 있으므로 이름은 항상 남기고 우리 클랜 연결은 있을 때만 남긴다. */
  /// 경기 당시 클랜명 (원본 표기 그대로). 근거가 없으면 null = 알 수 없음
  matchTimeClanName         String?
  /// 그 클랜이 우리 리그 클랜과 연결됐으면 그 id. 외부 클랜이면 null
  matchTimeLeagueClanId     String?
  matchTimeClanSlug         String?
  matchTimeClanMarkBgUrl    String?
  matchTimeClanMarkFrontUrl String?
  /// 근거의 출처 — "nexon-detail" | "roster" | "supply-lineup"
  matchTimeClanSource       String?
  /// 그 근거를 관측한 시각
  matchTimeClanObservedAt   DateTime?
  /// "high" | "medium" | "low"
  matchTimeClanConfidence   String?

  /* --- 래더 재현 정보 (LADDER_IMPLEMENTATION_SPEC 5장) --- */
  /// 배치고사 중이면 null (래더 자리에 `배치고사` 표기)
  ratingBefore Int?
  /// 배치고사 경기의 rating_update는 0
  ratingUpdate Int?
  ratingAfter  Int?
  /// 경기 시점 division 스냅샷 — 필수
  playerDivisionAtMatch   Int
  opponentDivisionAtMatch Int
  /// 상대 팀 선수들의 경기 직전 통합 개인 래더 평균 (공식 입력 Ro)
  opponentAvgRating Int?
  /// 사용된 K값 / 승리 배수 — 공식이 바뀌어도 당시 계산을 재현하기 위해 보관
  kUsed          Float?
  multiplierUsed Float?
  /// 계산에 쓰인 공식 버전. 이전 기록은 "3rd.supply-imported"로 표기해
  /// **추정 공식으로 덮어쓰지 않는다** (CLAUDE.md 3-A 2번)
  formulaVersion String?
  isPlacement    Boolean @default(false)

  /* --- 원본(3rd.supply) 점수 — 우리 계산과 **완전히 분리한다** (D-153) -------
     위의 `ratingBefore` / `ratingUpdate` 는 **우리가 계산한** 값이다(D-145).
     아래는 3rd.supply 가 그 경기에 실제로 보여 준 값이다. 둘을 한 칸에 담으면
     어느 쪽 숫자인지 알 수 없게 되고, 한 번 섞이면 되돌릴 수 없다.

     시즌7 베타의 **운영 화면은 아래 source 값을 쓴다.** 우리 공식(D-145)은
     코드와 컬럼을 남겨 두되 화면에 적용하지 않는다 — 미러가 안정된 뒤
     별도 검증을 거쳐 전환한다. */
  /// 3rd.supply 경기 상세 화면이 그 선수 자리에 **표시하는** 래더.
  ///
  /// **"경기 당시" 값이 아니다.** 실측으로 확인했다 — 한 선수의 162경기에서
  /// 이 값이 전부 같았다. 원본은 **수집 시점의 현재 래더**를 모든 행에 그대로 붙인다.
  /// `opponent.rating` / `opponent.division` 도 클랜별로 값이 하나뿐이라 같은 성격이다.
  ///
  /// 원본 화면을 그대로 재현하려고 담아 둘 뿐이다.
  /// **래더 재현의 입력으로 쓰면 안 된다** — 경기 시점 정보가 아니다.
  sourceRating      Int?
  /// 3rd.supply 의 그 경기 증감. **이건 경기마다 다르다** — 진짜 증감이 맞다.
  /// 원본값 그대로 보관하고 재계산하지 않는다 (3-A 2번)
  sourceRatingDelta Int?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId, matchId])
  @@index([matchId, side])
}

/* ========================================================================== */
/* 5. 랭킹 스냅샷 (1시간 주기 배치)                                             */
/* ========================================================================== */

/// 배치가 만들어 두는 랭킹 결과. 조회는 이 스냅샷을 읽는다.
model RankSnapshot {
  id          String   @id @default(cuid())
  leagueId    String
  /// "clan" | "player"
  kind        String
  /// 개인랭킹은 부리그 구분이 없어 null
  division    Int?
  seasonNumber Int
  generatedAt DateTime @default(now())
  /// 정렬 완료된 랭킹 행 배열
  payload     Json

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, kind, division, seasonNumber])
  @@index([generatedAt])
}

/* ========================================================================== */
/* 6. 게시판                                                                   */
/* ========================================================================== */

model BoardCategory {
  slug   String  @id
  name   String
  /// 공지 카테고리는 목록 상단에 고정 노출된다
  notice Boolean @default(false)
  order  Int     @default(0)

  boards Board[]

  @@index([order])
}

model Board {
  id           String @id @default(cuid())
  categorySlug String
  title        String
  /// 저장된 HTML. **저장 전 서버에서 새니타이즈한다.**
  content      String

  /// 비로그인 익명 글이면 null
  userId       String?
  /// 익명 글의 자동 별칭
  anonAlias    String?
  /// 비로그인 글 삭제용 비밀번호 해시. 평문 저장 금지.
  anonPasswordHash String?
  /// 0 = 일반(닉네임 공개), 그 외 = 익명. 0 이외 값 체계는 [미확인]
  discloseType Int    @default(0)
  /// 0 = 웹, 1 = 앱
  writerApp    Int    @default(0)

  viewCount    Int     @default(0)
  likeCount    Int     @default(0)
  dislikeCount Int     @default(0)
  commentCount Int     @default(0)
  hasImage     Boolean @default(false)
  /// 공지 고정 행 여부. 카테고리의 `notice`와 별개로 **글 단위**로도 고정할 수 있다
  /// (계약 `BoardListItem.notice`가 행마다 내려온다).
  notice       Boolean @default(false)

  /// "sacloud" | "mock" — 이 행이 어디서 왔는가 (D-116).
  /// `mock`은 개발용 시드다. **공개 화면에 내보내지 않는다.**
  origin     String    @default("sacloud")

  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastEdited DateTime?

  category BoardCategory @relation(fields: [categorySlug], references: [slug])
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments Comment[]

  // 목록: 카테고리별 최신순 (커서 페이지네이션)
  @@index([categorySlug, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  // 실시간 인기게시글
  @@index([likeCount(sort: Desc), createdAt(sort: Desc)])
  // 공개 목록: 시드 제외 + 최신순
  @@index([origin, createdAt(sort: Desc)])
}

/// 댓글. 원본은 대댓글 1단계까지만 허용한다(관측).
model Comment {
  id       String  @id @default(cuid())
  boardId  String
  /// null이면 최상위 댓글. 대댓글은 1단계까지만 — 부모의 parentId는 반드시 null이어야 한다.
  parentId String?
  content  String

  userId           String?
  anonAlias        String?
  anonPasswordHash String?
  discloseType     Int     @default(0)
  writerApp        Int     @default(0)

  likeCount    Int @default(0)
  dislikeCount Int @default(0)

  /// true면 **행은 남기고 내용만 가린다** (원본 관측). 물리 삭제하지 않는다.
  deleted    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastEdited DateTime?

  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([parentId])
}

/// 추천/비추천. 한 대상에 한 투표자당 1행.
/// 비로그인 투표는 `voterKey`에 익명 식별자(해시)를 넣는다.
model Vote {
  id         String @id @default(cuid())
  /// "board" | "comment"
  targetType String
  targetId   String
  voterKey   String
  /// -1 = 비추천, 0 = 취소, 1 = 추천. 정확한 값 체계는 [미확인]
  type       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([targetType, targetId, voterKey])
  @@index([targetType, targetId])
}

model Upload {
  id        String   @id @default(cuid())
  url       String
  ownerKey  String
  userId    String?
  byteSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ownerKey])
}

/* ========================================================================== */
/* 7. 마이그레이션 · 수집 (CLAUDE.md 3-A)                                       */
/* ========================================================================== */

/// **원본 응답 보관소. 어떤 경우에도 버리지 않는다.**
///
/// 변환 로직이나 래더 로직에 오류가 나와도 여기서 재변환·재검증할 수 있어야 한다
/// (CLAUDE.md 3-A 1번). 같은 대상을 다시 받아도 `migrationVersion`이 다르면 별도 행으로 쌓인다.
model RawImport {
  id       String @id @default(cuid())
  /// "3rd.supply" | "nexon"
  source   String
  /// 호출한 엔드포인트 경로
  endpoint String
  /// 원본 쪽 식별자 (클랜 slug, 매치 ID 등)
  sourceId String
  /// 요청 파라미터 — 재현에 필요하다
  /// **API 키를 저장하지 않는다.** 키는 헤더로만 나가며 여기에 담기지 않는다.
  requestParams Json?
  httpStatus    Int?
  /// 응답 본문 원형. 가공하지 않는다.
  raw           Json
  fetchedAt     DateTime @default(now())
  /// 수집 파이프라인 버전
  migrationVersion String

  /// 응답 본문의 내용 해시(sha256). **같은 내용이면 새 행을 만들지 않고**
  /// `fetchCount`/`lastFetchedAt`만 올린다. 내용이 달라지면 새 행을 추가한다(append-only).
  /// 유니크에 포함된 이유: 30일 갱신 재수집이 기존 원본을 덮어쓰면 원본 보존이 깨진다.
  contentHash   String   @default("")
  firstFetchedAt DateTime @default(now())
  lastFetchedAt  DateTime @default(now())
  fetchCount     Int      @default(1)

  /// 이 원본이 어떤 로컬 엔티티로 변환됐는지 (변환 전이면 null)
  normalizedAt DateTime?

  @@unique([source, endpoint, sourceId, migrationVersion, contentHash])
  @@index([source, endpoint, fetchedAt])
  @@index([source, endpoint, sourceId])
  @@index([normalizedAt])
}

/// 3rd.supply의 **시즌 최종 요약 스냅샷** (Legacy).
///
/// 목표는 원본 복제가 아니다. "내가 과거 시즌에 승률 몇 %, 킬뎃 몇이었는지"를
/// 사용자가 새 사이트에서 확인할 수 있는 수준까지만 보존한다.
/// 개별 경기·참가자·경기별 rating_update·게시판은 **이관 대상이 아니다.**
///
/// 운영 데이터와 섞지 않는다
/// - `LeaguePlayerSeason`(신규)과 **별도 테이블**이다. 조인하지 않는다.
/// - **신규 래더 공식으로 재계산하지 않는다.** 원본에 적힌 값을 그대로 둔다
///   (CLAUDE.md 3-A 2번).
/// - 원본에 없는 값은 `null`이다. **추측하거나 역산하지 않는다.**
///   승률만 있으면 `winRate`만 채우고 `wins`/`losses`는 null로 둔다.
///
/// 동일인 판정
/// - 닉네임을 영구 ID로 보지 않는다. `sourcePlayerId`가 있으면 그것을 보존한다.
/// - 닉네임만으로 현재 사용자와 **자동 병합하지 않는다.** 연결은 별도 검증 절차로 미룬다.
model LegacyPlayerSeason {
  id     String @id @default(cuid())
  /// "3rd.supply"
  source String @default("3rd.supply")

  /// 원본의 안정적인 플레이어 식별자. 페이지에서 얻지 못하면 null.
  sourcePlayerId String?
  /// 화면에 보이던 닉네임. **식별자가 아니다** (바뀔 수 있다).
  nickname       String

  /**
   * 지난시즌은 **리그마다 따로** 존재한다 (`/league/:slug/player/:id/season`).
   * 리그를 빼면 같은 시즌 번호의 다른 리그 기록이 서로 덮어쓴다.
   * 사용자 명세에는 없었지만 정확성에 필요해 넣었다.
   */
  leagueSlug String?
  season     Int
  division   Int?
  clanName   String?

  wins    Int?
  losses  Int?
  /// 승률 %. 원본이 승/패 없이 승률만 보여주면 이것만 채운다.
  winRate Float?

  kills  Int?
  deaths Int?
  /// 킬뎃 %. 원본 표기를 그대로 담는다 (`킬/(킬+데스)×100`).
  kd     Float?

  finalRating Int?
  finalRank   Int?
  /// 순위의 모집단 (원본이 "360명중 1위" 형태로 보여준다). 없으면 null.
  rankCount   Int?

  /// 어느 페이지에서 가져왔는지. 나중에 원본과 대조할 때 쓴다.
  sourceUrl   String?
  /// 화면에서 읽은 원문. 변환이 틀려도 여기서 다시 만들 수 있다 (CLAUDE.md 3-A 1번).
  rawSnapshot Json?

  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /**
   * 중복 방지 키. import 시 계산한다.
   * `<source>|<sourcePlayerId ?? "nick:"+nickname>|<leagueSlug ?? "-">|<season>`
   *
   * 왜 컬럼을 따로 두나: Postgres의 유니크 인덱스는 NULL을 서로 다른 값으로 본다.
   * `sourcePlayerId`나 `leagueSlug`가 비어 있으면 복합 유니크로는 중복이 걸러지지 않는다.
   * 같은 CSV를 여러 번 넣어도 한 행만 남아야 하므로 키를 명시적으로 만든다.
   */
  dedupeKey String @unique

  @@index([nickname])
  @@index([sourcePlayerId])
  @@index([leagueSlug, season])
}

/// Legacy 자동 수집 작업 (`pnpm legacy:collect`).
///
/// 5,000명은 한 번에 끝나지 않는다. 중간에 멈춰도 **이어서 할 수 있어야** 한다.
/// 그래서 진행 상황을 DB에 남긴다 (CLAUDE.md 3-A 4번: 일회성 스크립트 금지).
model LegacyCollectionJob {
  id     String @id @default(cuid())
  /// "3rd.supply"
  source String @default("3rd.supply")
  /// 수집 대상 리그. 현재는 서플라이공식리그(`supply`)뿐이다.
  leagueSlug String @default("supply")

  /// "running" | "done" | "stopped" | "blocked"
  /// `blocked` = 접근 통제(WAF/CAPTCHA/403)를 만나 **우회하지 않고 스스로 멈춘 상태**
  status String @default("running")

  totalPlayers     Int @default(0)
  processedPlayers Int @default(0)
  successPlayers   Int @default(0)
  failedPlayers    Int @default(0)
  rowsCreated      Int @default(0)

  /// 마지막으로 처리한 플레이어. 재개 지점.
  lastPlayerId String?
  /// 멈춘 이유 (blocked/stopped일 때)
  stopReason   String?

  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  players LegacyCollectionPlayer[]

  @@index([status, startedAt])
}

/// 플레이어 한 명의 수집 결과. 이미 끝난 사람은 재실행 때 건너뛴다.
model LegacyCollectionPlayer {
  id    String @id @default(cuid())
  jobId String

  sourcePlayerId String
  nickname       String?

  /// "pending" | "success" | "not_found" | "parse_failed" | "blocked" | "error"
  status String @default("pending")
  /// 재시도 횟수. 일시 오류(5xx·타임아웃)만 제한적으로 재시도한다.
  attempts    Int  @default(0)
  rowsCreated Int  @default(0)

  /// "http_404" | "http_403" | "http_429" | "waf_captcha" | "timeout" | "parse" | ...
  errorType    String?
  errorMessage String?
  httpStatus   Int?

  /// 처리에 걸린 시간(ms). 평균 산출용.
  durationMs Int?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  job LegacyCollectionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourcePlayerId])
  @@index([jobId, status])
  @@index([sourcePlayerId])
}

/// 원본 ID ↔ 로컬 ID 매핑. 엔티티 컬럼(`source*Id`)과 중복이지만,
/// 아직 로컬 엔티티가 없는 단계에서도 대조가 가능해야 해서 별도로 둔다.
model SourceMapping {
  id         String @id @default(cuid())
  source     String
  /// "player" | "clan" | "league" | "league_clan" | "league_player" | "match"
  entityType String
  sourceId   String
  localId    String

  createdAt DateTime @default(now())

  @@unique([source, entityType, sourceId])
  @@index([source, entityType, localId])
}

/// 중단 후 재개 가능한 파이프라인의 진행 상태 (CLAUDE.md 3-A 4번).
/// 일회성 스크립트를 금지하고, 커서를 DB에 남겨 언제든 이어받게 한다.
model ImportJob {
  id      String @id @default(cuid())
  source  String
  /// 작업 단위 키 (예: "clan:abc123:matches")
  jobKey  String
  /// "pending" | "running" | "done" | "failed"
  status  String @default("pending")
  /// 다음에 이어받을 위치
  cursor  String?
  /// 처리 완료 건수 — 숫자 대조 검증에 쓴다 (CLAUDE.md 3-A 6번)
  processed Int   @default(0)
  /// 원본이 알려준 전체 건수 (모르면 null)
  expected  Int?

  attempts    Int       @default(0)
  lastError   String?
  /// exponential backoff — 이 시각 전에는 재시도하지 않는다
  nextRetryAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  migrationVersion String

  @@unique([source, jobKey, migrationVersion])
  @@index([status, nextRetryAt])
}

/// 개별 항목 실패 기록. **실패를 성공으로 처리하지 않기 위해** 남긴다.
model ImportFailure {
  id        String   @id @default(cuid())
  source    String
  jobKey    String
  sourceId  String?
  reason    String
  detail    Json?
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([source, jobKey])
  @@index([resolvedAt])
}

/// 마이그레이션 검증 결과. "수집 완료" 로그가 아니라 **숫자 대조**로 판정한다
/// (CLAUDE.md 3-A 6번).
model MigrationCheck {
  id        String   @id @default(cuid())
  /// 검사 이름 (예: "match_count:league:xxx")
  name      String
  /// 원본에서 센 값
  expected  Int
  /// 우리 DB에서 센 값
  actual    Int
  passed    Boolean
  note      String?
  checkedAt DateTime @default(now())

  migrationVersion String

  @@index([migrationVersion, passed])
  @@index([name])
}

/* ========================================================================== */
/* 7-N. 넥슨 Open API 수집 스테이징 (Phase 8)                                   */
/* ========================================================================== */
//
// 흐름은 반드시 아래 순서를 지킨다 (`docs/NEXON_INGEST_SPEC.md` 2장).
//   Nexon 응답 → RawImport → normalize → NexonMatch/NexonMatchParticipant
//              → validate → projection rule → Match / MatchPlayerStat
// 넥슨 응답을 운영 `Match`에 **바로 넣지 않는다.**

/// 넥슨 계정 식별자(ouid) 한 개. **ouid만으로 영구 동일인을 가정하지 않는다.**
///
/// 넥슨은 "게임 콘텐츠 변경으로 ouid가 변경될 수 있다"고 명시했고, 닉네임도 영구 식별자가
/// 아니다. 그래서 `Player` 연결은 **근거가 있을 때만** 하고, 근거가 부족하면
/// `NexonIdentityCandidate`로 남겨 사람이 판단하게 한다 (D-036).
model NexonIdentity {
  id       String  @id @default(cuid())
  ouid     String  @unique
  playerId String?

  /// "unresolved" | "active" | "superseded" | "conflicted"
  /// 기본값은 unresolved — ouid를 알아냈다고 해서 누구인지 아는 것은 아니다.
  status   String  @default("unresolved")

  /// 마지막으로 관측된 닉네임 (스냅샷, 식별자가 아니다)
  userName String?

  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  /// 넥슨에서 마지막으로 값을 확인한 시각 (신선도 정책 기준)
  lastVerifiedAt DateTime?

  linkedAt   DateTime?
  /// 연결 근거. 자동 연결을 금지하므로 사람이 남긴 사유가 들어간다
  linkReason String?
  linkedBy   String?

  /// 같은 사람의 더 새로운 ouid가 확인됐을 때. **행을 지우지 않는다**
  supersededByOuid String?
  supersededAt     DateTime?

  /* --- 병영수첩 계정과의 다리 (D-221) --------------------------------------
     두 세계의 식별자가 다르다. `ouid` 는 32자리 hex, 병영수첩은 숫자(`user_nexon_sn`)와
     `...SA` 꼴(`str_usn`)을 쓴다. 닉네임이 유일한 다리인데 `/id` 는 **지금 그 닉을 쓰는
     사람**을 주므로, 조회만으로 잇지 않고 `user/basic` 으로 **되돌려 확인**한 것만 채운다. */
  /// 병영수첩 `user_nexon_sn` (숫자)
  barracksNexonSn String?
  /// 병영수첩 `str_usn` (`...SA`). 클랜 페이지 URL 에 쓰이는 값이다
  barracksUsn String?
  /// 어떤 닉으로 이었나 — 나중에 대조할 수 있게 남긴다
  barracksLinkNick String?
  barracksLinkedAt DateTime?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player     Player?                  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  candidates NexonIdentityCandidate[] @relation("CandidateIdentity")

  @@index([status])
  @@index([playerId])
  @@index([userName])
  @@index([barracksNexonSn])
  @@index([barracksUsn])
}

/// 닉네임 관측 이력. 매치 상세는 참가자 ouid를 주지 않고 닉네임만 준다.
///
/// 닉네임 → 플레이어 해석의 **보조 자료**일 뿐이다. 여기 있는 값으로 자동 병합하지 않는다.
model NexonNickname {
  id            String @id @default(cuid())
  nickname      String
  /// 대소문자 무시 비교용
  nicknameLower String
  /// 관측 출처가 매치 상세면 ouid를 모른다 → null
  ouid          String?
  /// `ouid ?? "-"`. Postgres는 NULL을 서로 다른 값으로 보므로 유니크에 NULL을 넣을 수 없다
  /// (legacy `dedupeKey`와 같은 이유)
  identityKey   String
  source        String @default("nexon")
  observations  Int    @default(1)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([nicknameLower, identityKey])
  @@index([ouid])
  @@index([nicknameLower])
}

/// 신원 연결 **후보**. 자동 승인 경로는 만들지 않는다 (D-036).
model NexonIdentityCandidate {
  id   String @id @default(cuid())
  ouid String

  /// 연결 후보 플레이어 (있으면)
  targetPlayerId String?
  /// ouid 변경 후보 — 같은 사람으로 의심되는 다른 ouid
  targetOuid     String?

  /// "nickname_match" | "ouid_change" | "manual"
  reason   String
  /// 판단 근거 원문 (관측된 닉네임·시각·건수 등)
  evidence Json?

  /// "open" | "accepted" | "rejected"
  status String @default("open")

  /// 중복 후보 방지. `ouid|targetPlayerId ?? "-"|targetOuid ?? "-"|reason`
  candidateKey String @unique

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  note       String?

  identity NexonIdentity @relation("CandidateIdentity", fields: [ouid], references: [ouid], onDelete: Cascade)
  player   Player?       @relation(fields: [targetPlayerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([ouid])
  @@index([targetPlayerId])
}

/// 넥슨 매치 스테이징. 운영 `Match`와 **분리**된 표다.
///
/// `matchType`은 원본 그대로 보존한다. 클랜전이 아니라는 이유로 버리거나 바꾸지 않는다.
/// 사용 여부 판단은 투영 규칙에서만 한다 (G 결정).
model NexonMatch {
  id            String @id @default(cuid())
  source        String @default("nexon")
  /// 넥슨 원본 match_id. **내부 `Match.id`로 쓰지 않는다** (B 결정)
  sourceMatchId String

  matchMode String?
  matchType String?
  dateMatch DateTime?
  matchMap  String?
  participantCount Int?

  /// 이 경기를 처음 발견한 ouid (목록 조회 주체). 원본 전체는 RawImport에 있다
  discoveredByOuid String?
  /// 발견 경로. 넥슨 목록에서 나왔으면 null, 3rd.supply 스냅샷 seed 면 "3rd.supply" (D-127).
  /// **사실값의 출처가 아니다** — 맵·참가자는 언제나 넥슨 /match-detail 응답에서 온다
  discoverySource  String?

  listRawImportId   String?
  detailRawImportId String?
  detailFetchedAt   DateTime?

  /// "pending" | "valid" | "invalid"
  validationStatus String @default("pending")
  validationIssues Json?

  /// "pending" | "projected" | "skipped" | "blocked"
  projectionStatus String  @default("pending")
  projectionReason String?
  /// roster 기반 재구성 판정 결과 요약 (관측 수 · 확정 참가자 수 · 팀별 인원 등).
  /// **증거를 남기기 위한 것**이지 계산 결과가 아니다 (Phase 8.2)
  reconstruction   Json?
  reconstructedAt  DateTime?

  /// 확인 수준 (Phase 9 · D-068 · D-074).
  ///
  /// 공식전 인정 기준은 **본클랜원** 3명씩이지만(D-071), 확인 수준은 **출전자 전원** 기준이다.
  /// 두 숫자를 따로 남겨야 "본클랜원 3 + 용병 2"와 "본클랜원 5"를 구분할 수 있다.
  winnerMembersConfirmed      Int?
  loserMembersConfirmed       Int?
  winnerMercenariesConfirmed  Int?
  loserMercenariesConfirmed   Int?
  /// 본클랜원 + 용병 (실제 확인된 출전 인원)
  winnerConfirmed             Int?
  loserConfirmed              Int?
  observationParticipantCount Int?
  detailParticipantCount      Int?
  /// "5v5" 처럼 사람이 읽을 수 있는 확인 수준 (출전자 전원 기준)
  participantCompleteness     String?
  /// "high" | "medium" | "low"
  reconstructionConfidence    String?
  /// 공식 통계 반영 대상인가 (D-079). false면 참고 기록이다
  official                    Boolean @default(true)

  /// 투영된 운영 매치의 내부 ID (FK를 걸지 않는다 — 스테이징은 외부 데이터의 거울이다)
  projectedMatchId String?
  projectedAt      DateTime?

  /// 신선도 정책 (`NEXON_REFRESH_INTERVAL_DAYS`, 기본 30일)
  lastVerifiedAt DateTime  @default(now())
  refreshDueAt   DateTime?
  staleAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants NexonMatchParticipant[]
  observations NexonMatchObservation[]

  @@unique([source, sourceMatchId])
  @@index([projectionStatus])
  @@index([validationStatus])
  @@index([refreshDueAt])
  @@index([dateMatch])
  @@index([matchType])
}

/// 넥슨 매치 참가자 스테이징.
///
/// 넥슨은 참가자 ouid를 주지 않는다(닉네임만). 그래서 안정 키는 **응답 배열 순서(slot)** 뿐이다.
/// 결측값은 전부 null이며 기본값으로 채우지 않는다.
model NexonMatchParticipant {
  id           String @id @default(cuid())
  nexonMatchId String
  slot         Int

  teamId      String?
  /// 원본 코드 그대로 (1 승 / 2 패 / 3 무)
  matchResult String?
  /// 해석값 "win" | "lose" | "draw" — 모르면 null
  outcome     String?

  userName    String?
  seasonGrade String?
  /// 클랜전 계열에서만 내려온다
  clanName    String?

  kill     Int?
  death    Int?
  assist   Int?
  headshot Int?
  damage   Float?

  /// 이 기록의 출처. `match_detail` = 상세 응답에서 왔다.
  /// 목록에서 온 개인 관측값은 **여기 넣지 않고** `NexonMatchObservation`에 따로 쌓는다 (D-048).
  source String @default("match_detail")

  /// 닉네임 해석 결과. **모호하면 비워 둔다** (자동 병합 금지)
  resolvedPlayerId String?
  resolvedOuid     String?
  /// "unresolved" | "resolved" | "ambiguous"
  resolutionStatus String @default("unresolved")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nexonMatch NexonMatch @relation(fields: [nexonMatchId], references: [id], onDelete: Cascade)

  @@unique([nexonMatchId, slot])
  @@index([userName])
  @@index([clanName])
  @@index([resolvedPlayerId])
}

/// 매치 목록에서 얻은 **개인 관측값**.
///
/// 넥슨 매치 상세는 참가자 일부만 준다(D-044). 반면 매치 목록은 조회 대상 본인의
/// kill/death/assist와 승패를 준다. 같은 경기를 여러 사람이 조회하면 그 사람들 기록을
/// 모을 수 있다 — **다만 그건 상세가 아니다.** 출처를 섞지 않기 위해 표를 분리한다 (D-048).
///
/// **여기 있는 사람만 저장한다.** 나오지 않은 참가자를 추측해서 만들지 않는다.
model NexonMatchObservation {
  id           String @id @default(cuid())
  nexonMatchId String
  /// 이 관측을 만든 조회 대상 (목록을 부른 계정)
  ouid         String
  /// 관측 시점의 닉네임 스냅샷 (식별자가 아니다)
  userName     String?

  /// 원본 코드 그대로 (1 승 / 2 패 / 3 무)
  matchResult String?
  outcome     String?
  kill        Int?
  death       Int?
  assist      Int?

  /// 출처 표기 — `player_match_list`
  source      String   @default("player_match_list")
  rawImportId String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  nexonMatch NexonMatch @relation(fields: [nexonMatchId], references: [id], onDelete: Cascade)

  @@unique([nexonMatchId, ouid])
  @@index([ouid])
}

/// 계정별 폴링 상태 (Phase 8.1 — adaptive polling).
///
/// 5,000명을 같은 주기로 전수 조회하지 않는다. 새 경기가 나오는 사람은 자주,
/// 조용한 사람은 뜸하게 본다. 주기 숫자는 코드가 아니라 설정에서 온다 (D-049).
model NexonPollState {
  id       String  @id @default(cuid())
  ouid     String  @unique
  /// 참고용. 신원의 권위는 `NexonIdentity`에 있다
  playerId String?

  /// "hot" | "warm" | "cold" | "dormant"
  tier            String @default("hot")
  /// 현재 적용 중인 주기(분). tier 기본값에서 시작하되 실제 적용값을 보존한다
  intervalMinutes Int    @default(60)

  lastPolledAt         DateTime?
  lastSuccessfulPollAt DateTime?
  /// 다음 조회 예정 시각. 큐는 이 값이 지난 대상만 가져간다
  nextPollAt           DateTime  @default(now())
  /// 마지막으로 **새 경기**를 발견한 시각
  lastNewMatchAt       DateTime?

  /// 연속으로 새 경기가 없었던 횟수 — 강등 판단 기준
  consecutiveEmptyPolls Int @default(0)
  /// 최근 창(window) 동안 발견한 새 경기 수
  recentNewMatchCount   Int @default(0)

  /// 사용자가 화면에서 `전적갱신`을 눌렀다. **최우선**으로 올라간다
  manualRefreshRequestedAt DateTime?

  /// "league" = 공식리그 등록 선수 (우선 수집 대상) | "general"
  /// 리그 선수를 먼저 보는 이유: 우리가 완성해야 하는 것은 **리그 경기**이기 때문이다 (D-053)
  priorityClass String @default("general")
  /// 같은 로스터 동료에게서 새 클랜전이 발견돼 앞당겨졌다 (match propagation)
  propagatedAt  DateTime?
  propagationReason String?

  /// "success" | "empty" | "failed" | "blocked"
  lastPollStatus String?
  lastError      String?

  totalPolls       Int @default(0)
  totalNewMatches  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextPollAt])
  @@index([tier, nextPollAt])
  @@index([manualRefreshRequestedAt])
  @@index([playerId])
  @@index([priorityClass, nextPollAt])
}

/// 수집 실행 1회의 호출량 계측 (Phase 8.1 — D 요구사항).
///
/// 5,000명 운영 비용을 **추정이 아니라 숫자로** 계산하기 위한 기록이다.
/// 신원 관측 이력 — **닉·클랜이 바뀐 순간을 기록한다** (D-220).
///
/// 왜 별도 표인가
///   `NexonIdentity.userName` 은 "지금 값" 하나만 갖는다. 그것만 갱신하면
///   **언제 바뀌었는지**가 사라진다. 우리가 병영수첩보다 빠르다는 것을 보이려면
///   바뀐 시각이 남아야 한다. 그래서 바뀔 때마다 한 줄씩 덧붙인다(append-only).
///
///   폴링할 때마다 넣지 않는다. **직전 관측과 달라졌을 때만** 넣는다.
model NexonIdentityObservation {
  id   String @id @default(cuid())
  ouid String

  /// 관측 시점의 닉네임 (`user/basic.user_name`)
  userName String?
  /// 관측 시점의 클랜명 (`user/basic.clan_name`). 무소속이면 null
  clanName String?

  /// 관측 시점의 칭호 (`user/basic.title_name`). 미착용이면 null.
  /// **이미 받아 놓고 버리던 값이다** — 남기는 데 넥슨 추가 호출이 0건이다
  titleName String?

  /// 무엇이 달라져서 이 줄이 생겼나
  /// "first" | "nickname" | "clan" | "title" | "nickname+clan" | "nickname+title"
  /// | "clan+title" | "nickname+clan+title"
  changed String

  /// 직전 값 — 대조용으로 함께 남긴다
  prevUserName String?
  prevClanName String?
  prevTitleName String?

  observedAt DateTime @default(now())

  @@index([ouid, observedAt])
  @@index([observedAt])
}

model NexonPollRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  playersPolled         Int @default(0)
  matchListRequests     Int @default(0)
  uniqueNewMatchIds     Int @default(0)
  duplicateMatchIds     Int @default(0)
  matchDetailRequests   Int @default(0)
  detailSkippedByDedupe Int @default(0)
  emptyPolls            Int @default(0)
  rateLimitedCount      Int @default(0)
  failedPolls           Int @default(0)

  /// 새 경기가 있었던 대상 / 없었던 대상 (평균 호출 수 계산용)
  activePlayersPolled   Int @default(0)
  inactivePlayersPolled Int @default(0)
  requestsForActive     Int @default(0)
  requestsForInactive   Int @default(0)

  migrationVersion String
  note             String?

  @@index([startedAt])
}

/// 경기 시점의 **클랜 소속 근거** (Phase 8.2).
///
/// 넥슨은 참가자의 클랜을 문자열(`guild_name`)로만 주고, 그것도 상세에 나온 사람만 준다.
/// 반면 SACLOUD는 리그 운영자로서 **누가 언제 어느 클랜 소속으로 등록됐는지**를 안다.
/// 그 사실을 기간(from~to)으로 보존해, "이 경기 시각에 이 선수가 이 클랜이었는가"를
/// 문자열 비교가 아니라 **등록 기록**으로 판정한다 (D-052).
///
/// 리그 시스템을 재설계하지 않는다. 판정에 필요한 최소한만 둔다.
model LeagueRosterMembership {
  id           String  @id @default(cuid())
  leagueId     String
  leagueClanId String
  playerId     String
  /// 시즌을 알면 남긴다. 몰라도 기간으로 판정할 수 있다
  seasonId     String?

  /// 소속 시작. **이 시각 이후의 경기부터** 이 클랜 소속으로 본다
  joinedAt DateTime
  /// 소속 종료 (null이면 현재까지)
  leftAt   DateTime?

  /// "manual" | "import" | "seed" | "3rd.supply-clan-players" — 근거의 출처
  source   String  @default("manual")
  /// 이 소속을 **관측한 시각** (D-130). 가입 시각이 아니다 — 공개 출처는 "지금 상태"만 준다
  observedAt DateTime?
  /// "high" | "medium" | "low" — 근거의 강도
  confidence String?
  /// 근거 식별자 (스냅샷 capturedAt 등). 나중에 원본과 대조하기 위한 것이다
  sourceRef  String?
  /// 운영자가 확인했는가. 확인되지 않은 소속은 완전성 판정에 쓰지 않는다
  verified Boolean @default(false)
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league     League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueClan LeagueClan @relation(fields: [leagueClanId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season     Season?    @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@unique([leagueClanId, playerId, joinedAt])
  @@index([playerId, joinedAt])
  @@index([leagueId, joinedAt])
  @@index([leagueClanId])
}

/* ========================================================================== */
/* 8. 래더 설정                                                                */
/* ========================================================================== */

/// 래더 상수. **코드에 하드코딩하지 않는다** (LADDER_IMPLEMENTATION_SPEC 7장).
/// 역추적 조사 결과가 갱신되면 이 설정값만 바꾼다.
///
/// division 조합별로 행을 둔다. `divisionKey` 예: "1v1", "2v2", "1v2", "2v1".
model RatingConfig {
  id       String  @id @default(cuid())
  /// null이면 전역 기본값
  leagueId String?
  divisionKey String

  /// D — 기대승률 분모 (관측 3400)
  expectedScoreDivisor Float @default(3400)
  /// 패배 시 K (div1: 24 / div2: 30)
  loseK                Float
  /// 승리 배수 (div1: 1.15 / div2: 1.00)
  winMultiplier        Float
  /// div1이 div2를 상대할 때 0.6 (div2 측은 1.0).
  /// **0.6의 정확한 내부 적용 위치는 [미확인]** — 조사 후 확정한다.
  crossDivisionMultiplier Float @default(1.0)

  formulaVersion String
  effectiveFrom  DateTime @default(now())

  league League? @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, divisionKey, formulaVersion])
}

/* ========================================================================== */
/* 9. 운영                                                                     */
/* ========================================================================== */

/// 관리자 조치 감사 로그. 되돌릴 수 없는 조치(추방·삭제·시즌 종료)를 남긴다.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetType String
  targetId  String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// 서버 측 rate limit (글쓰기 5분 제한 등, 관측).
/// Redis 도입 전까지 DB로 처리한다. Phase 8에서 Redis로 옮길 수 있다.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
}

/// 병영수첩 BattleLog 원문 (Phase 12 · D-114).
///
/// **원문을 버리지 않는다** (`CLAUDE.md` 3-A 1번). 판정기(classifier)를 고쳐도
/// 외부에 다시 요청하지 않고 여기서 재계산할 수 있어야 한다.
model BarracksRawImport {
  id       String @id @default(cuid())
  source   String @default("nexon_barracks")
  endpoint String
  /// 넥슨 match_id 와 같은 값이다 (= `Match.sourceMatchId`)
  matchKey String
  clanNo   String

  payload     Json
  /// 같은 응답을 여러 번 넣어도 행이 늘지 않게 하는 키
  payloadHash String
  /// "ok" | "error"
  status    String  @default("ok")
  errorCode String?

  fetchedAt DateTime @default(now())
  /// 같은 내용이면 다시 저장하지 않고 이 값만 올린다
  fetchCount Int     @default(1)

  @@unique([matchKey, clanNo, payloadHash])
  @@index([matchKey])
  @@index([fetchedAt])
}

/// 병영수첩 BattleLog **원문** — 좌표까지 그대로 (D-174).
///
/// `BarracksRawImport` 와 나눠 둔 이유: 그쪽은 **클랜 단위** 응답을 무기 판정용으로 담는다.
/// 포지션은 **선수 단위** 응답(`GetBattleLog/<match_key>/<str_usn>`)이 필요하고,
/// 한 경기에 최대 10줄이 생긴다. 키가 다르므로 표를 나눈다.
///
/// **가공한 값을 여기 넣지 않는다.** 구역·포지션은 이 원문에서 언제든 다시 계산한다
/// (`CLAUDE.md` 3-A 1번). 규칙을 바꿔도 재수집하지 않는다.
model BarracksBattleLogRaw {
  id       String @id @default(cuid())
  source   String @default("nexon_barracks")
  endpoint String
  /// 넥슨 match_id 와 같은 값 (= `Match.sourceMatchId`)
  matchKey String
  /// 이 로그의 주인. 선수 단위면 `str_usn`, 클랜 단위면 클랜 번호
  subject String
  /// "user" | "clan" — 어느 단위로 받은 응답인지. 섞이면 참가자 수가 거짓이 된다
  subjectKind String @default("user")

  payload     Json
  /// 같은 응답을 여러 번 넣어도 행이 늘지 않게 하는 키
  payloadHash String
  /// "ok" | "error"
  status    String  @default("ok")
  errorCode String?

  fetchedAt DateTime @default(now())
  /// 같은 내용이면 다시 저장하지 않고 이 값만 올린다
  fetchCount Int @default(1)

  @@unique([matchKey, subject, payloadHash])
  @@index([matchKey])
  @@index([subject])
  @@index([fetchedAt])
}

/// 병영수첩 **클랜전 목록** 원문 (`GetClanMatchList`) — IPL 기록 이관.
///
/// `BarracksBattleLogRaw` 와 나눠 둔 이유: 그쪽은 **한 경기 안의 사건 로그**(좌표·킬)다.
/// 이 표는 **클랜의 경기 목록 한 줄**이다. 한 줄에 양 팀 이름과 라운드 스코어가 함께 온다
/// (`docs/IPL_SPEC.md` 7장). 넥슨 Open API 의 D-044 제약이 여기엔 없다.
///
/// **같은 경기가 양쪽 클랜 목록에 다 나온다.** 그래서 조회 주체(`subject`)가 키에 들어간다.
/// 두 줄은 `result_wdl`(조회 주체 기준 승/패)이 서로 달라 내용도 다르다. 지우지 않는다.
///
/// **가공한 값을 여기 넣지 않는다.** 경기·참가자·래더로의 투영은 규칙이 따로 있고
/// (D-155 · `CLAUDE.md` 3-B) 별도 작업이다. 이 표는 원문 보존까지만 한다
/// (`CLAUDE.md` 3-A 1번).
model BarracksClanMatchRaw {
  id       String @id @default(cuid())
  source   String @default("nexon_barracks")
  endpoint String @default("/api/ClanHome/GetClanMatchList/")
  /// 넥슨 match_id 와 같은 값 (= `Match.sourceMatchId`). 앞 12자리가 경기 시각이다
  matchKey String
  /// 이 목록을 **조회한 클랜**의 병영수첩 slug (`clan_id`). 경기의 주인이 아니다
  subject String

  /// `GetClanMatchList` 응답 배열의 **한 항목 그대로**
  payload     Json
  /// 같은 응답을 여러 번 넣어도 행이 늘지 않게 하는 키
  payloadHash String
  /// "ok" | "error"
  status    String  @default("ok")
  errorCode String?

  fetchedAt DateTime @default(now())
  /// 같은 내용이면 다시 저장하지 않고 이 값만 올린다
  fetchCount Int @default(1)

  @@unique([matchKey, subject, payloadHash])
  @@index([matchKey])
  @@index([subject])
  @@index([fetchedAt])
}

/// 선수의 **자리 분포와 포지션 판정** (D-174).
///
/// 원본이 주는 `Player.position`(선수가 직접 등록한 값)과 **다른 값이다. 섞지 않는다.**
/// 분포(`histogram`)를 함께 저장해 판정 규칙이 바뀌어도 원문 재수집 없이 다시 고른다.
model PlayerPositionProfile {
  id String @id @default(cuid())
  /// 병영수첩 계정 번호. **닉네임이 아니라 이 값이 사람의 키다**
  userNexonSn String
  /// 우리 Player 와 연결된 경우만. 못 찾으면 null 로 두고 분포는 그대로 보존한다
  playerId String?

  /// "2F" | "B" | "SHORT" | ... 못 고르면 null — 찍지 않는다
  position String?
  /// 1등 중심과의 닮음 (0~1)
  score Float @default(0)
  /// 2등과의 차이. 붙어 있으면 믿을 값이 아니다
  margin Float @default(0)

  /// 분포에 쓴 경기 수 (스나 든 판을 뺀 뒤)
  games Int @default(0)
  /// 스나를 들어서 뺀 경기 수
  sniperGamesExcluded Int @default(0)
  /// 좌표 개수
  points Int @default(0)
  /// 격자 분포 — 이 값이 있으면 재계산에 원문이 필요 없다
  histogram Json

  classifierVersion String
  computedAt        DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([userNexonSn, classifierVersion])
  @@index([playerId])
  @@index([position])
}

/// 병영수첩 **클랜 번호** ↔ 우리 클랜 (D-200).
///
/// 배틀로그를 부르려면 `경기키 + 그 경기에 뛴 클랜의 번호` 가 필요하다.
/// 클랜 번호는 병영수첩만 아는 값이라 우리 `Clan.slug` 로는 못 부른다.
///
/// 이 표는 **이미 받은 응답에서 배운 것**만 담는다 — 응답의 `teamList` 가
/// 양 팀 번호를 알려 주므로, 받을수록 아는 클랜이 늘고 더 받을 수 있게 된다.
/// 지어내지 않는다 (D-106).
/// 병영수첩 **클랜원 명단** 관측 (D-219).
///
/// ── 왜 필요한가
///   원문 어디에도 **선수별 소속 클랜이 없다.** 배틀로그는 "이 팀으로 뛰었다" 까지만 알려 주고
///   그 사람이 그 클랜 **소속**인지는 말해 주지 않는다. 용병과 구별이 안 된다.
///   그런데 그 구별이 D-219(열산의심)와 클랜 알 30% 계산이 하려는 일 전부다.
///
/// ── 어디서 오나
///   `POST /api/ClanHome/GetClanUserList` (병영수첩). 2026-08-31 에 사용자가 찾아 줬다.
///   응답이 `str_usn` · `user_nexon_sn` 을 주는데 **우리 배틀로그와 같은 값**이라
///   닉네임 추측 없이 계정을 바로 잇는다.
///
/// ── 관측이다. 사실이 아니다
///   명단은 시간이 지나면 바뀐다. 그래서 **관측 시각(`observedAt`)을 반드시 함께** 둔다.
///   "지금 명단" 이 아니라 "그때 본 명단" 이다. 같은 사람을 여러 번 관측하면 줄이 늘어난다.
/// 「알」이 깨진 기록 (`docs/EGG_SYSTEM_SPEC.md`).
///
/// ── 왜 표로 남기나
///   깨진 상태를 화면이 계산으로 매번 구하면, **누가 언제 왜 깼는지**가 사라진다.
///   특히 관리자가 강제로 깬 것과 사람이 인증해서 깬 것은 뜻이 다르다. 둘을 구분해 남긴다.
///
/// ── 되돌릴 수 있다
///   지우면 다시 잠긴다. 관리자가 시험 삼아 깨 보고 되돌릴 수 있어야 한다.
model EggBreak {
  id String @id @default(cuid())

  /// "player" | "clan"
  targetKind String
  /// 선수면 `Player.id`, 클랜이면 `Clan.slug`
  targetId String

  /// 왜 깨졌나
  ///   "verified"  본인 인증으로 (사양 4장)
  ///   "master"    클랜마스터가 직접 (사양 3장)
  ///   "quorum"    클랜원 30% 달성
  ///   "admin"     관리자가 강제로 — **시험용이다. 진짜 근거가 아니다**
  reason String

  /// 깬 사람 (관리자 강제이면 그 관리자). 시스템이 깼으면 null
  brokenByUserId String?
  /// 사람이 남긴 메모
  note String?

  brokenAt DateTime @default(now())

  @@unique([targetKind, targetId])
  @@index([targetKind])
  @@index([brokenAt])
}

model BarracksClanMember {
  id String @id @default(cuid())

  /// 병영수첩 클랜 slug (= `clan_id`, URL 에 쓰이는 값)
  clanSlug String
  /// 관측 당시의 클랜 이름 — 개명을 추적할 수 있게 남긴다
  clanName String?

  /// 계정 고유값. 배틀로그의 `str_usn` 과 같다
  strUsn String
  /// 계정 고유값(숫자). 배틀로그의 `user_nexon_sn` 과 같다
  userNexonSn String

  /// 관측 당시 닉네임. **표시에 쓰지 않는다** — 위장닉이 섞인다 (D-221)
  userNick String?
  /// 클랜마스터 · 부마스터 · 정예클랜원 · 클랜원 · 견습 …
  clanLevel String?
  /// 기여도 원문 (예: "기여 520,125")
  clanExp String?
  /// 관측 시점 접속 여부. 1 이면 접속중
  connFlag Int @default(0)
  punishFlag Int @default(0)
  authFlag String?

  observedAt DateTime @default(now())

  @@unique([clanSlug, strUsn, observedAt])
  @@index([clanSlug, observedAt])
  @@index([strUsn])
  @@index([userNexonSn])
}

model BarracksClanNumber {
  /// 병영수첩 클랜 번호 (예: `070328039332`)
  clanNo String @id
  clanId String

  /// 어떻게 이어졌나 — `roster`(참가 선수 대조) · `teamlist`(응답이 직접 알려 줌)
  source String @default("roster")
  /// 그 판단의 근거 수. 낮으면 의심한다
  votes Int @default(1)

  linkedAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

/// 선수의 **라운드 복원 집계** (D-194).
///
/// 육각형 세 축(세이브 · 매치의 사나이 · 소수싸움)과 우리 MVP 가 이 값을 쓴다.
/// `PlayerPositionProfile`(D-174)과 같은 자리에 같은 방식으로 둔다 —
/// 사람의 키는 닉네임이 아니라 **병영수첩 계정 번호**다.
///
/// **원본(3rd.supply)에 없는 값이다.** 원본의 `save_cnt` 와도 다르다 —
/// 넥슨은 1대3 이상만 세이브로 세지만 우리는 **혼자 남으면 전부** 센다 (사양 4절).
///
/// 세지 못한 경기는 여기 들어오지 않는다. 그래서 분모(`matches`)가 그 선수가 실제로
/// 뛴 판수보다 **작다.** 0으로 채우지 않는다 (D-106).
model PlayerRoundProfile {
  id String @id @default(cuid())
  /// 병영수첩 계정 번호. **닉네임이 아니라 이 값이 사람의 키다**
  userNexonSn String
  /// 우리 Player 와 연결된 경우만. 못 찾으면 null 로 두고 집계는 그대로 보존한다
  playerId String?

  /// 라운드 복원에 **성공한** 경기 수 (양 팀 5명이 전부 확인된 경기)
  matches Int @default(0)
  /// 혼자 남은 라운드 수 — 세이브의 분모
  alone Int @default(0)
  /// 그중 이긴 라운드 수 — 세이브의 분자
  aloneWon Int @default(0)
  /// 본인 포함 둘이 남은 라운드 수. **2:1 은 세지 않는다** (사양 4절).
  ///
  /// ⚠ **혼자 남기까지 간 라운드는 여기 들어오지 않는다.** 그 라운드는 `alone` 이다.
  /// 즉 "둘이 남아서 그 상태로 끝났거나 내가 먼저 죽은" 라운드만 센다.
  /// 두 축의 분모를 겹치게 두면 같은 라운드가 세이브에도 소수싸움에도 세어져
  /// 한 상황이 두 번 평가된다.
  outnumbered Int @default(0)
  outnumberedWon Int @default(0)

  /// 20분 초과 경기 중 **마지막 라운드 최다 킬**이었던 횟수
  matchMan Int @default(0)
  /// 그 판정이 가능했던 20분 초과 경기 수 — 매치의 사나이의 분모.
  /// 동률이라 아무도 못 뽑은 경기는 여기 들어오지 않는다
  longMatches Int @default(0)

  /// 스나싸움 — 스나싸움 구역에서 상대 **스나**와 얽힌 교전 수 (D-195)
  ///
  /// 그 선수가 **스나를 든 경기**만 센다. 라플 든 판의 교전을 여기 넣으면 무기가 섞인다.
  snipeDuels Int @default(0)
  /// 그중 이긴 것(내가 잡은 것)
  snipeDuelWins Int @default(0)

  /// 작업 성공률의 분모 — 상대 무기를 아는 내 킬 전체 (스나 든 경기만)
  workKills Int @default(0)
  /// 그중 상대가 **라플**이었던 것. 이 비율이 `작업 성공률` 이다
  workRifleKills Int @default(0)

  /// 원어택 성공률의 분모 — 상대 포지션을 아는 내 킬 (라플 든 경기만 · D-196)
  oneAttackKills Int @default(0)
  /// 그중 상대가 **나와 같은 포지션**이었던 것
  oneAttackSameKills Int @default(0)

  /// **기회창출**(육각형 4번 · D-214) — 라운드의 **첫 킬**을 낸 라운드 수.
  ///
  /// 라운드마다 첫 킬은 정확히 한 명이 낸다. 10명이 나눠 가지므로 평균 비율은 0.10 이다.
  openingKills Int @default(0)
  /// 그 분모 — 첫 킬을 **가릴 수 있었던** 라운드 수.
  ///
  /// 가장 이른 죽음이 같은 초에 둘 이상이면 누가 먼저인지 모른다.
  /// 그런 라운드는 **분모에서도 뺀다** — 분모에만 남기면 아무도 못 딴 라운드가
  /// 모두의 비율을 함께 끌어내린다 (D-106).
  openingRounds Int @default(0)

  /// **연속킬**(육각형 5번 · D-260) — ★**지금 축이 쓰는 분자**★ (2026-09-02).
  ///
  /// 그 라운드에 2초 이하 연쇄가 **한 번이라도** 있었던 라운드 수.
  /// 한 라운드에 연쇄가 여러 번이어도 **1 만 오른다** — 「비율」이지 「횟수」가 아니다.
  ///
  /// 사용자가 후보 셋 중 **(c) 「연속킬을 한 번이라도 낸 라운드 비율」**을 골랐다.
  /// 분모는 `burstKillRounds` 다.
  ///
  /// ⚠ `ClanRoundProfile.burstRounds` 와 **이름은 같지만 다른 값이다.**
  /// 그쪽은 클랜 단위 「몰아치기 라운드」이고 이쪽은 선수 한 명의 것이다.
  burstRounds Int @default(0)
  /// 같은 값을 5초 창으로 본 것. **지금은 안 쓴다** — 창을 바꿔도 재집계가 없게 담아 둔다
  burstRoundsWide Int @default(0)

  /// 옛 해석 (a) 의 분자 — 직전 킬과의 간격이 2초 **이하**인 킬 수.
  ///
  /// 한 라운드 안에서만 이어진다. `event_time` 이 경기 누적이라(D-174) 라운드를 안 보면
  /// 다음 라운드 첫 킬이 2초 안에 들어와 연속킬로 둔갑한다.
  ///
  /// ⚠ **정정 (2026-09-02)** — 이 칸이 한때 축의 분자였다. 지금은 `burstRounds` 다.
  /// **지우지 않는다** — 되돌아갈 때 재집계가 필요 없어야 한다 (`CLAUDE.md` 10-4).
  burstChained Int @default(0)
  /// 옛 해석 (a) 의 분모 — 라운드와 시각을 **아는** 그 선수의 총 킬 수.
  ///
  /// ⚠ **정정 (2026-09-02)** — 아래 서술은 첫 판의 근거다. **합리적이지만 사용자가
  /// (c) 를 골랐다.** 지우지 않고 남긴다.
  /// > `킬을 낸 라운드 수` 로 하면 라운드당 1킬만 내는 선수가 항상 0 이 되고,
  /// > `뛴 라운드 수` 로 하면 킬을 많이 낸 사람이 유리해진다. 총 킬이 가장 곧게 읽힌다 —
  /// > **"내 킬 중 몇 %가 연속킬로 이어졌나"**.
  burstKills Int @default(0)

  /// 창을 5초로 넓혔을 때의 분자. **지금 화면은 쓰지 않는다.**
  ///
  /// 2초가 너무 좁다고 판명되면 이 칸으로 갈아탄다. 함께 담아 두는 이유는 그때
  /// **집계를 다시 돌리지 않기 위해서**다 (`ClanRoundProfile` 의 되잡기 창 넷과 같은 뜻).
  burstChainedWide Int @default(0)

  /// 그 선수가 킬을 낸 라운드 수 — ★**지금 축이 쓰는 분모**★ (2026-09-02).
  ///
  /// ⚠ 분모가 이것인지 「뛴 라운드 전부」인지는 사용자가 안 정했다 `[미확인]`.
  /// (c) 의 자연스러운 읽기인 **킬을 낸 라운드**를 기본으로 했다.
  burstKillRounds Int @default(0)
  /// 그중 한 라운드에서 **2킬 이상**을 낸 라운드 수 — 「라운드당 2명」 정의의 분자.
  ///
  /// 사용자가 «전자(2초)와 후자(라운드당 2명)를 구분할 수 있으면 진짜 괜찮은 정보» 라고
  /// 해서 둘 다 담는다.
  ///
  /// ⚠ **`burstRounds` 의 대용이 아니다.** 이쪽은 **시간을 안 본다** — 라운드 처음과 끝에
  /// 하나씩 잡아도 오른다. 두 지표의 순위상관이 **0.419** 로 실측됐다. 섞어 쓰지 마라.
  burstMultiKillRounds Int @default(0)

  /// 집계 규칙 버전. 규칙이 바뀌면 새 줄이 생기고 옛 줄은 남는다
  builderVersion String
  computedAt     DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([userNexonSn, builderVersion])
  @@index([playerId])
}

/// 클랜의 **라운드 복원 집계** — 배틀로그로만 잴 수 있는 지표 다섯 + 클린시트
/// (`docs/SITE_SPEC_V2.md` 5-5절).
///
/// ```
/// 블루방어율 · 어택성공률 · 조직력 · 폭발력 · 게임템포 · 클린시트(반코트)
/// ```
///
/// **원본(3rd.supply)에 없는 값이다.** 사용자 지시로 만든 신규 지표다.
///
/// ── 왜 `LeagueClan` 이 키인가
///   같은 클랜이 여러 리그를 겸하고, 같은 물리 경기가 리그마다 다른 `Match` 행이 된다
///   (D-155). 클랜 단위로 묶으면 리그가 섞여 클랜페이지(리그별 화면)와 모집단이 어긋난다.
///
/// ── 분자와 분모를 **따로** 담는다 (D-106)
///   비율을 미리 계산해 넣지 않는다. 진영을 모르는 라운드는 분모에서도 빠지므로,
///   표본이 얼마인지(`roundsKnown` / `roundsTotal`)를 함께 봐야 값의 무게를 안다.
///   표본이 최소치에 못 미치면 화면은 `측정중` 이다 — **0% 가 아니다.**
model ClanRoundProfile {
  id           String @id @default(cuid())
  leagueClanId String
  /// 병영수첩 클랜 번호. 어느 응답에서 나온 값인지 되짚는 근거다 (D-200)
  clanNo String?

  /// 배틀로그가 있고 모집단(래더 + 시즌 창) 안이라 훑은 경기 수
  matches Int @default(0)
  /// 그중 **진영 교대를 확인해** 실제로 지표에 쓴 경기 수.
  /// 교대를 못 본 경기는 아는 라운드가 "폭탄이 터진 라운드" 뿐이라 표본이 근거와
  /// 같아진다 — 통째로 뺀다 (`packages/nexon/src/clanRound.ts` 머리말)
  sidedMatches Int @default(0)

  /// 이벤트로 확인된 라운드 수 (진영을 몰라도 센다)
  roundsTotal Int @default(0)
  /// 그중 진영을 **아는** 라운드 수. 둘의 차이가 못 잰 몫이다
  roundsKnown Int @default(0)

  /// 블루방어율 — 수비 라운드 중 내준 비율의 분모/분자
  defenseRounds   Int @default(0)
  defenseConceded Int @default(0)

  /// 어택성공률 — 공격 라운드 중 딴 비율의 분모/분자
  attackRounds Int @default(0)
  attackWon    Int @default(0)
  /// 폭탄 설치의 분모(승패를 몰라도 세는 공격 라운드)와 분자
  attackSideRounds Int @default(0)
  plantRounds      Int @default(0)

  /// 조직력 — 잰 공격 라운드 수와 그중 30초를 넘긴 횟수.
  /// **5대5가 확인된 경기에서만** 잰다 (빠진 이벤트가 없는 조직력을 만들어 내지 않게)
  organizedRounds Int @default(0)
  organizedHeld   Int @default(0)

  /// 폭발력 — 잰 공격 라운드 수와 그 안에서 일어난 연속 제거 횟수
  burstRounds Int @default(0)
  bursts      Int @default(0)

  /// 게임템포 — 라운드 길이의 **중앙값**(초). 표본이 없으면 null 이다.
  ///
  /// 두 벌을 남긴다. `span` 은 관측 구간(마지막−첫 이벤트)이라 실제 길이의 **하한**이고,
  /// `gap` 은 다음 라운드까지의 간격이라 **상한**이다. 어느 쪽을 화면이 쓸지 바뀌어도
  /// 다시 집계하지 않게 둘 다 보존한다 (사용자 지시 — 바꿔도 앞 버전을 남긴다)
  tempoSpanRounds Int    @default(0)
  tempoSpanMedian Float?
  tempoGapRounds  Int    @default(0)
  tempoGapMedian  Float?

  /// 클린시트(반코트) — 한 진영에서 5라운드를 전승한 경기 수와 그 판정이 가능했던 경기 수.
  /// 한 경기에서 두 진영을 다 쓸어도 **한 번**으로 센다 (원문 `800판중 120회`)
  cleanSheetMatches Int @default(0)
  cleanSheets       Int @default(0)

  /// 소수싸움 — 우리 생존자가 상대보다 적어진 순간이 있었던 라운드 수와 그중 이긴 수
  /// (원문 `소수싸움:839회중 432회 승리 n%`).
  ///
  /// ⚠ 이 축만 **진영을 보지 않는다.** 숫자가 밀리는 것은 공격이든 수비든 일어나므로
  /// 교대를 못 본 경기에서도 세어진다 — 그래서 위의 라운드 수들보다 **훨씬 크다.**
  /// 대신 5대5가 확인된 경기에서만 잰다 (빠진 죽음이 밀린 라운드를 감추지 않게).
  ///
  /// 선수 축(`PlayerRoundProfile.outnumbered`)을 클랜별로 **더한 값이 아니다** —
  /// 한 라운드가 두 번 세어지고, 현재 소속으로 조인해야 해서 3-B 4번을 어긴다
  outnumberedRounds Int @default(0)
  outnumberedWon    Int @default(0)

  /// 집계 규칙 버전. 규칙이 바뀌면 새 줄이 생기고 옛 줄은 남는다
  builderVersion String
  computedAt     DateTime @default(now())

  leagueClan LeagueClan @relation(fields: [leagueClanId], references: [id], onDelete: Cascade)

  @@unique([leagueClanId, builderVersion])
  @@index([leagueClanId])
}

/// 경기 × 선수 무기 판정 근거 (D-114).
///
/// 판정 결과만 남기지 않는다. **왜 그렇게 판정했는지**를 같이 남겨야
/// 나중에 사람이 검증하고, 판정기를 바꿔 다시 계산할 수 있다.
model MatchWeaponEvidence {
  id       String @id @default(cuid())
  matchKey String
  /// 병영수첩 계정 번호. **닉네임이 아니라 이 값이 사람의 키다**
  userNexonSn String
  nickname    String?
  /// 우리 Player와 연결된 경우만. 못 찾으면 null로 두고 근거는 그대로 보존한다
  playerId    String?

  /* --- 신호 --- */
  rifleKills  Int
  sniperKills Int
  /// 응답에 없으면 null. 0으로 채우지 않는다 (모름과 0은 다르다)
  arHits Int?
  srHits Int?

  /* --- 판정 --- */
  /// "rifle" | "sniper" | "unknown"
  classification       String
  classificationReason String
  classifierVersion    String

  source    String   @default("nexon_barracks")
  rawId     String?
  fetchedAt DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([matchKey, userNexonSn])
  @@index([matchKey])
  @@index([playerId])
  @@index([classification])
}

/// 선수의 **플레이스타일 바** 재료 — 진영별 집계 (`docs/PLAYER_TRAITS_SPEC.md` 8절 · D-211).
///
/// ```
/// 블루 = 수비   안전함   ↔  변칙적
/// 레드 = 공격   느린전개 ↔  빠른전개
/// ```
///
/// **원본(3rd.supply)에 없는 값이다.** 사용자 지시로 만든 신규 지표다.
///
/// ── 왜 `PlayerRoundProfile` 에 칸을 더하지 않았나
///   저건 육각형(세이브·소수싸움·매치의 사나이)의 그릇이고 **진영을 보지 않는다.**
///   여기 값들은 전부 진영으로 갈라 센 것이라 최소 표본도 판정 시점도 다르다.
///   한 표에 섞으면 `builderVersion` 하나가 성격이 다른 두 집계를 함께 묶게 된다.
///
/// ── 분자와 분모를 **따로** 담는다 (D-106)
///   비율을 미리 계산해 넣지 않는다. 진영을 모르는 라운드는 분모에서도 빠지므로
///   표본이 얼마인지(`defenseRounds` / `attackRounds`)를 함께 봐야 값의 무게를 안다.
///   표본이 최소치에 못 미치면 화면은 `측정중` 이다 — **가운데(`정석`)가 아니다.**
model PlayerPlaystyleProfile {
  id String @id @default(cuid())
  /// 병영수첩 계정 번호. **닉네임이 아니라 이 값이 사람의 키다**
  userNexonSn String
  /// 우리 Player 와 연결된 경우만. 못 찾으면 null 로 두고 집계는 그대로 보존한다
  playerId String?

  /// 진영을 확정해 실제로 쓴 경기 수
  matches Int @default(0)

  /* --- 블루(수비) 라운드 --- */
  /// 수비로 뛴, 교전이 있었던 라운드 수 — 모든 수비 축의 분모
  defenseRounds Int @default(0)
  /// 그중 **라운드 첫 교전의 당사자**였던 라운드 수
  defenseOpening Int @default(0)
  /// 첫 교전 지연의 합(초)과 잰 라운드 수
  defenseDelaySum Float @default(0)
  defenseDelayN   Int   @default(0)
  /// 자리 흩어짐의 재료 — 교전 좌표의 합·제곱합. 분산은 `E[x²] − E[x]²` 로 나온다
  defensePosX  Float @default(0)
  defensePosY  Float @default(0)
  defensePosX2 Float @default(0)
  defensePosY2 Float @default(0)
  defensePosN  Int   @default(0)

  /* --- 레드(공격) 라운드 --- */
  attackRounds  Int @default(0)
  attackOpening Int @default(0)
  attackDelaySum Float @default(0)
  attackDelayN   Int   @default(0)
  attackPosX  Float @default(0)
  attackPosY  Float @default(0)
  attackPosX2 Float @default(0)
  attackPosY2 Float @default(0)
  attackPosN  Int   @default(0)

  /// 집계 규칙 버전. 규칙이 바뀌면 새 줄이 생기고 **옛 줄은 남는다**
  builderVersion String
  computedAt     DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([userNexonSn, builderVersion])
  @@index([playerId])
}

/// **클랜 육각형 V2 — 경기 한 건 × 클랜 한 곳의 원재료** (D-217 사양 · D-235 결정).
///
/// ── 왜 «경기 단위» 인가
///   사용자 원문이 두 가지를 함께 시켰다 — *"매 판마다 비교해서 경기상세에"* 와
///   *"전부모아서 평균 낸 후 해당클랜 페이지에"*. 경기 단위로 두면 **둘 다 여기서 나온다.**
///   클랜 값은 이 행들의 **합**이다. 클랜용 표를 따로 만들지 않는다 — 표가 둘이면
///   둘이 어긋날 자리가 생기고, 합은 언제나 맞다.
///
/// ── 왜 `LeagueClan` 이 키인가
///   같은 클랜이 여러 리그를 겸하고 같은 물리 경기가 리그마다 다른 `Match` 가 된다 (D-155).
///   클랜으로 묶으면 리그가 섞여 클랜페이지(리그별 화면)와 모집단이 어긋난다.
///   `ClanRoundProfile` 이 같은 이유로 같은 키를 쓴다.
///
/// ── 왜 `tally` 가 **JSON** 인가
///   축의 해석이 아직 흔들린다 (D-235 의 Q1·Q5·Q7·Q8 은 **우리가 정한 값**이지
///   사용자가 확인해 준 값이 아니다). 35칸짜리 표로 펴면 해석 하나 바뀔 때마다
///   마이그레이션이 따라온다. 행은 1만 개 남짓이라 합산은 JS 로 충분하다.
///
///   담기는 것은 `packages/nexon/src/clanHexV2.ts` 의 `ClanHexTally` **통째**다.
///   **비율은 저장하지 않는다** — 분자/분모만 둔다 (D-106). 비율을 미리 넣으면
///   5라운드 경기가 18라운드 경기와 같은 무게를 갖는다.
///
/// ── 옛 판을 지우지 않는다
///   `ClanRoundProfile`(D-201)은 그대로 산다. 육각형만 이쪽으로 갈아탄다 (D-235 Q9).
///   ⚠ 두 표의 `게임템포` 는 **이름만 같고 다른 지표다. 한 화면에 나란히 놓지 않는다.**
model MatchClanHexV2 {
  id           String @id @default(cuid())
  matchId      String
  leagueClanId String

  /// 병영수첩 클랜 번호. 어느 응답에서 나온 값인지 되짚는 근거다 (D-200)
  clanNo String?
  /// 이 집계의 주인 (`team_no` — **진영이 아니다** · D-184)
  teamNo String
  /// 상대 `team_no`. 못 찾으면 null 이고 그때는 여섯 축이 전부 null 이다
  foeTeamNo String?

  /// 이벤트로 확인된 라운드 수 (진영을 몰라도 센다)
  rounds Int @default(0)
  /// 그중 진영을 **아는** 라운드 수
  sidedRounds Int @default(0)
  /// 그중 진영=레드(공격)인 라운드 수. 여섯 중 넷이 이 값에 매달린다
  redRounds Int @default(0)
  /// 상대 팀에서 **스나로 확정된** 선수 수. 0 이면 ①⑤⑥ 이 null 이다
  foeSnipers Int @default(0)

  /// 이 경기에서 실제로 재진 축 수 (0~6). 화면의 `측정중 N/6` 과 목록 거르기에 쓴다
  axesMeasured Int @default(0)

  /// `ClanHexTally` 통째. **분자/분모만 있고 비율은 없다**
  tally Json

  /// 어느 판의 계산기가 만들었나 (3-B 5번). 판이 바뀌면 이 값으로 골라 다시 만든다
  formulaVersion String
  builtAt        DateTime @default(now())

  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  leagueClan LeagueClan @relation(fields: [leagueClanId], references: [id], onDelete: Cascade)

  @@unique([matchId, leagueClanId])
  @@index([leagueClanId, formulaVersion])
  @@index([formulaVersion, builtAt])
}

/// **클랜 육각형 V2 의 접어 둔 사본 — 클랜 하나에 한 행** (D-238 후속).
///
/// ── ⛔ 이 표는 **사본이다. 진실의 출처는 `MatchClanHexV2` 다**
///   여기 있는 `tally` 는 그 클랜의 경기 행들을 `sumClanHexTallies` 로 **접은 결과**다.
///   이 표가 통째로 사라져도 `nexon clan-hex-v2-summary` 를 한 번 돌리면 똑같이
///   복원된다. 반대는 성립하지 않는다 — 원재료를 지우면 아무것도 못 만든다.
///   **원재료를 지우거나 바꾸지 않는다.**
///
/// ── 왜 만들었나 — **이 자리가 운영을 500 으로 만들었다** (D-238)
///   클랜 페이지 육각형은 「같은 리그에서 몇 등인가」(백분위 · D-235 Q8)다. 등수를
///   매기려면 리그의 모든 클랜 값이 필요한데, 지금까지는 `MatchClanHexV2` 를 리그
///   통째로 읽어 그 자리에서 접었다. 열산 6,230행 × tally 1.1KB = **7MB 를 한 요청에**
///   끌어왔고 `/api/leagues/supply/clans/lpcrew/show` 가 10.6초 → 500 이 됐다.
///   읽는 양이 「리그의 경기 행 수」에서 **「리그의 클랜 수」**로 바뀐다.
///
/// ── ⚠ **D-235 의 «표를 둘로 나누지 않는다» 에 대한 예외다**
///   그 결정을 뒤집는 것이 아니다. D-235 가 걱정한 «둘이 어긋날 자리» 는 실재한다.
///   다만 그 원칙을 지킨 결과가 **화면이 아예 안 뜨는 것**이었다. 값이 맞아도 안 보이면
///   없는 것과 같다. 그래서 원재료는 그대로 두고 **사본**을 하나 더 둔다.
///
///   어긋나면 어떻게 아나 — 둘이다.
///     ① `formulaVersion` — 계약(`CLAN_HEX_V2_CONFIG.formulaVersion`)과 다른 행은
///        화면이 **아예 안 읽는다.** 해석이 바뀌면 옛 요약은 자동으로 «없는 것» 이 되고
///        화면은 `측정중` 으로 떨어진다. 틀린 값을 그리는 것보다 낫다
///     ② **재생성으로 대조한다** — `clan-hex-v2-summary --rebuild` 는 원재료에서 다시
///        접는다. 결과가 다르면 어긋난 것이고 **언제나 원재료 쪽이 옳다**
///
/// ── 왜 여섯 숫자가 아니라 `tally` 통째인가
///   비율을 저장하면 5라운드 경기가 18라운드 경기와 같은 무게를 갖는다 (D-235 Q8).
///   그리고 **세는 규칙은 계약 한 곳에만 있어야 한다** — 여섯 칸을 만들면 나누는 규칙이
///   SQL 로 새어 나간다. 그래서 접힌 것도 분자/분모다. 화면은 이걸 `buildClanHexV2Raw`
///   에 그대로 넣고, 리그 전체를 접어 만들던 것과 **같은 값**을 얻는다
///   (분자·분모 덧셈이라 결합법칙이 성립한다).
///
/// ── 판(formulaVersion)마다 행을 쌓지 않는다
///   클랜 하나에 한 행이고 판이 바뀌면 **덮는다.** 옛 판의 근거는 `MatchClanHexV2` 에
///   그대로 남아 있으므로 여기서 판을 보존할 이유가 없다.
model ClanHexV2Summary {
  id String @id @default(cuid())

  /// 클랜 하나에 한 행. 멱등 upsert 의 키다
  leagueClanId String @unique
  /// 백분위 모집단을 고르는 키. 조인 없이 바로 거른다
  leagueId     String

  /// 이 값으로 접었다는 표시 (3-B 5번). 계약과 다르면 화면이 안 읽는다
  formulaVersion String

  /// `sumClanHexTallies` 의 결과 통째. **비율이 아니라 분자/분모다**
  tally Json

  /// 접는 데 쓴 경기 행 수. `buildClanHexV2Raw` 의 `matches` 로 그대로 들어간다
  matches Int @default(0)
  /// 접힌 tally 기준 `null` 이 아닌 축 수 (0~6). 대조용이다
  axesMeasured Int @default(0)

  builtAt DateTime @default(now())

  leagueClan LeagueClan @relation(fields: [leagueClanId], references: [id], onDelete: Cascade)
  league     League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueId, formulaVersion])
  @@index([formulaVersion, builtAt])
}

/// ★★수집기 단일 실행 보장 — 임대(lease)★★ (2026-09-04 · Pre-Part 0 · 사장님 지시).
///
/// ── 왜 표를 새로 만드나
///   자물쇠가 ★세 번★ 뚫렸다. 셋 다 같은 이유다 — ★자물쇠가 이 컴퓨터 안에만 있었다.★
///   ```
///   1차  멈추는 도구가 셸만 죽이고 아래 프로세스를 남겼다        → 잠금 파일을 달았다
///   2차  잠금 파일의 ★셸 번호★ 만 봤다. 셸이 죽고 일꾼이 남았다   → 프로세스를 세게 바꿨다
///   3차  ★프로세스를 세는 순간이 하필 「쉬는 중」이었다★          → 두 판이 같이 돌았다
///   ```
///   3차는 2026-09-04 14:56 에 ★실제로 잡혔다★ — `collect-3leagues.sh` 두 판이
///   10:13 과 12:23 부터 나란히 돌고 있었고 로그가 섞여 있었다.
///
///   ★프로세스 목록을 세는 방식은 원리적으로 못 고친다.★ 수집기는 한 판이 도는 동안
///   ★일꾼이 없는 구간★(투영·쉼)이 길다. 그 구간을 「안 돌고 있다」와 구별할 수 없다.
///
/// ── 그래서 무엇으로 바꾸나
///   ```
///   ★전★  「지금 도는 프로세스가 있나」   ← 상태를 ★관찰★ 한다. 관찰은 틈이 있다
///   ★후★  「내가 임대를 쥐었나」          ← 상태를 ★선언★ 한다. 틈이 없다
///   ```
///   임대는 ★한 문장짜리 SQL★ 로 잡는다 (`INSERT … ON CONFLICT … WHERE`).
///   두 판이 같은 순간에 달려들어도 ★행 잠금 때문에 정확히 하나만 성공한다.★
///   프로세스가 몇 겹이든, 쉬고 있든, 무슨 이름이든 상관이 없다.
///
/// ── 죽은 임대는 스스로 풀린다
///   프로세스가 죽으면서 임대만 남으면 ★영영 못 돌게 된다 — 그게 더 나쁘다.★
///   그래서 `expiresAt` 을 두고 ★도는 동안 계속 갱신한다(heartbeat).★
///   갱신이 끊기면 만료되고 다음 판이 가져간다.
///
///   ⚠ ★만료 시간은 「한 요청」이 아니라 「한 사이클」보다 넉넉해야 한다.★
///     짧으면 살아 있는 판의 임대를 남이 뺏어 가고, 그게 곧 두 판이다.
///
/// ── 이 표는 잠금이면서 ★장부★ 다
///   누가·어디서·언제부터 쥐고 있는지가 남는다. 「지금 몇 개 도나」를
///   ★프로세스 목록이 아니라 이 표로★ 답할 수 있다.
model CollectorLease {
  /// 무엇에 대한 임대인가. 지금은 `barracks-collect` 하나다
  name String @id

  /// ★이 판을 가리키는 값★ — 실행할 때마다 새로 만든다.
  /// 갱신·반납은 이 값이 맞을 때만 된다. ★남의 임대를 못 건드린다★
  ownerId String

  /// 어느 컴퓨터인가. 사람이 읽으려고 남긴다
  host String
  /// 임대를 잡은 셸의 번호. ★판정에 쓰지 않는다★ — 판정은 `expiresAt` 이 한다.
  /// 다른 컴퓨터의 번호는 여기서 확인할 수 없기 때문이다
  pid Int
  /// 무엇을 돌리는 판인가 (예: `collect-3leagues.sh`)
  command String?

  acquiredAt  DateTime @default(now()) @db.Timestamptz(3)
  /// 마지막으로 살아 있다고 알린 시각
  heartbeatAt DateTime @db.Timestamptz(3)
  /// ★이 시각이 지나면 죽은 것으로 본다★ — 다음 판이 가져갈 수 있다
  expiresAt   DateTime @db.Timestamptz(3)
  /// 정상적으로 반납한 시각. 반납된 임대는 만료를 기다리지 않고 바로 넘어간다
  releasedAt  DateTime? @db.Timestamptz(3)

  /// 이 임대를 몇 번 갱신했나 — 진짜 돌고 있었는지 나중에 볼 수 있다
  renewCount Int @default(0)
  /// 임대를 잡으려다 거절당한 횟수. ★막은 횟수가 곧 이 장치의 성과다★
  blockedCount Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
}
