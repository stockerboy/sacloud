// SACLOUD — Prisma 스키마 (Phase 7)
//
// 설계 기준
// 1. `packages/contract`의 Zod 계약이 단일 진실 원천이다. 이 스키마는 그 계약을
//    **채울 수 있는** 형태여야 한다. 계약에 없는 필드를 화면에 노출하지 않는다.
// 2. `CLAUDE.md` 3-A장(마이그레이션 절대 규칙)을 스키마 수준에서 강제한다.
//    - 원본 응답(Raw)을 버리지 않는다        → `RawImport`
//    - 원본 ID를 버리지 않는다               → 각 엔티티의 `source*` 컬럼 + `SourceMapping`
//    - 기존 rating_update를 덮어쓰지 않는다  → `MatchPlayerStat.origin` / `formulaVersion`
//    - 중단 후 재개 가능한 파이프라인        → `ImportJob` / `ImportFailure`
// 3. `docs/LADDER_IMPLEMENTATION_SPEC.md`의 재현성 요구를 반영한다.
//    경기 시점 division 스냅샷과 계산 입력값을 참가자별로 저장한다.
//
// 파생값 저장 정책
//   승률·킬뎃%·경기당킬 같은 **계산 가능한 값은 저장하지 않는다.** 조회 시 계산한다.
//   원본과 어긋날 여지를 없애기 위함이다.
//   예외: `rating`은 랭킹 정렬에 인덱스가 필요해 유지 컬럼으로 둔다(아래 주석 참조).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  /**
   * 운영(Vercel) 런타임용 엔진을 함께 받는다.
   *
   * Vercel 의 서버리스 런타임은 Amazon Linux 라 `rhel-openssl-3.0.x` 엔진이 필요하다.
   * `native` 만 두면 개발 PC(Windows) 엔진만 생기고, 배포하면 런타임에서
   * "could not locate the Query Engine for runtime rhel-openssl-3.0.x" 로 죽는다.
   * 실제로 그렇게 죽었다 (2026-08-27 · D-151).
   *
   * 엔진 파일을 람다 번들에 **복사**하는 것은 별개 문제다 —
   * `apps/web/next.config.ts` 의 `outputFileTracingIncludes` 가 담당한다.
   */
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ========================================================================== */
/* 1. 계정 · 인증                                                              */
/* ========================================================================== */

/// 서비스 회원. 원본은 이메일/비밀번호 단일 방식이며 네이버 메일만 허용한다(관측).
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  /// **유일 제약을 걸지 않는다.** 원본이 닉네임 중복을 막는지는 [미확인]이라
  /// 확인되지 않은 제약을 임의로 만들지 않는다 (CLAUDE.md 3장 7번).
  /// 중복 금지가 확인되면 그때 `@unique`로 바꾸고 마이그레이션을 추가한다.
  nickname        String
  avatarUrl       String?
  /// `codes.ts` ROLE: 0 = 일반, 2 = 운영자. 그 외 값의 의미는 [미확인]
  role            Int       @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  playerLink    UserPlayerLink?
  linkClaims    PlayerLinkClaim[]
  ownedLeagues  League[]
  boards        Board[]
  comments      Comment[]
  authTokens    AuthToken[]
  refreshTokens RefreshToken[]
  uploads       Upload[]

  @@index([createdAt])
  @@index([nickname])
}

/// 서든어택 계정 연동. 연동해야 리그 생성이 가능하다(관측).
/// 원본의 실제 소유권 인증 방식은 [미확인] — 연동 시각만 기록한다.
model UserPlayerLink {
  userId     String   @id
  playerId   String   @unique
  verifiedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

/// 서든어택 계정 연동 **신청** (D-121).
///
/// 넥슨 Open API에는 사용자가 계정 소유를 증명할 수단이 없다 —
/// 엔드포인트가 전부 닉네임으로 조회하는 **공개 정보**이고, OAuth도 동의 흐름도 없다.
/// 그래서 "닉네임을 아는 사람이 곧 주인"이 되는 자동 연결을 폐기하고,
/// **운영자가 근거를 보고 승인**하는 구조로 바꿨다.
///
/// 없는 증명을 흉내 내지 않는다. 확인할 수 없으면 확인했다고 하지 않는다.
model PlayerLinkClaim {
  id       String @id @default(cuid())
  userId   String
  playerId String

  /// "pending" | "approved" | "rejected" | "cancelled"
  status   String @default("pending")
  /// 신청자가 적은 근거 (클랜 동료 확인·스크린샷 위치 등). 운영자가 읽고 판단한다
  evidence String?

  createdAt DateTime @default(now())
  /// 처리 시각·처리자. 계정이 지워져도 이력은 남기려고 FK를 걸지 않는다
  decidedAt        DateTime?
  decidedByUserId  String?
  decidedByEmail   String?
  decisionNote     String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// 같은 사람이 같은 선수를 중복 신청하지 않는다
  @@unique([userId, playerId])
  @@index([status, createdAt])
  @@index([playerId, status])
}

/// 이메일 인증 / 비밀번호 재설정 토큰. 평문을 저장하지 않고 해시만 보관한다.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  /// "email_verify" | "password_reset"
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// 리프레시 토큰. 계약의 `AuthSession.refresh_token`에 대응한다.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/* ========================================================================== */
/* 2. 도메인 — 플레이어 · 클랜                                                  */
/* ========================================================================== */

/// 서든어택 플레이어. 리그와 무관한 전역 엔티티다.
model Player {
  id        String    @id @default(cuid())
  name      String
  clanId    String?
  /// 클랜 내 포지션 메모 (예: "2층")
  position  String?
  /// 플레이어 소개/메모 (원본 `note`)
  note      String?
  /// 마지막 `정보갱신` 시각
  renewedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /* --- 원본 대조용. 버리지 않는다 (CLAUDE.md 3-A 3번) --- */
  /// 3rd.supply의 플레이어 ID
  sourcePlayerId String?
  /// 넥슨 계정 식별자(ouid) **비권위 캐시**.
  /// 넥슨이 ouid 변경 가능성을 명시했으므로 이 값을 영구 동일인 판단 근거로 쓰지 않는다.
  /// 권위 있는 매핑은 `NexonIdentity`에 있다 (D-036).
  nexonOuid      String?
  /// "sacloud" | "nexon" | "3rd.supply" | "mock" — 이 행이 어디서 왔는가 (D-116).
  /// `mock`은 개발용 시드다. **공개 화면에 내보내지 않는다.**
  origin         String  @default("sacloud")

  clan          Clan?           @relation("ClanMembers", fields: [clanId], references: [id], onDelete: SetNull)
  masterOf      Clan[]          @relation("ClanMaster")
  userLink      UserPlayerLink?
  linkClaims    PlayerLinkClaim[]
  leaguePlayers LeaguePlayer[]
  matchStats    MatchPlayerStat[]
  mvpMatches    Match[]         @relation("MatchMvp")
  nexonIdentities         NexonIdentity[]
  nexonIdentityCandidates NexonIdentityCandidate[]
  rosterMemberships       LeagueRosterMembership[]
  weaponEvidence          MatchWeaponEvidence[]

  @@unique([sourcePlayerId])
  @@unique([nexonOuid])
  @@index([name])
  @@index([clanId])
  @@index([origin])
}

/// 클랜. 원본은 넥슨 병영수첩 slug를 그대로 식별자로 쓴다(관측).
model Clan {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  /// 클랜마크 2레이어. 원본 이미지를 복사하지 않고 URL만 보관한다.
  markBgUrl      String?
  markFrontUrl   String?
  masterPlayerId String?
  notice         String?
  establishedAt  DateTime? @db.Date
  /// 마지막 `전적갱신` 시각
  renewedAt      DateTime?
  /// 클랜 설정 — 리그 초대 차단
  blockInvitation Boolean  @default(false)

  /* --- 운영 구분 (Phase 10) --- */
  /// "official" = 공식리그 참여 클랜 | "independent" = 무소속
  category   String  @default("official")
  /// 무소속 클랜의 티어 1~5. **자동 승강하지 않는다.** 운영자가 직접 정한다
  tier       Int?
  /// 비활성 클랜은 랭킹·목록에서 감춘다. **삭제 대신 이 값을 쓴다**
  active     Boolean @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// 3rd.supply의 클랜 ID
  sourceClanId String?
  /// "sacloud" | "nexon" | "3rd.supply" | "mock" — 이 행이 어디서 왔는가 (D-116).
  /// `mock`은 개발용 시드다. **공개 화면에 내보내지 않는다.**
  origin       String  @default("sacloud")

  master        Player?        @relation("ClanMaster", fields: [masterPlayerId], references: [id], onDelete: SetNull)
  members       Player[]       @relation("ClanMembers")
  leagueClans   LeagueClan[]
  leaguePlayers LeaguePlayer[] @relation("LeaguePlayerClan")
  invitations LeagueInvitation[]
  aliases     ClanAlias[]

  @@unique([sourceClanId])
  @@index([name])
  @@index([origin])
}

/// 클랜의 다른 표기 (Phase 10).
///
/// 넥슨 상세가 주는 `guild_name`이 우리 클랜명과 글자가 다를 수 있다.
/// **비슷하다고 자동으로 묶지 않는다** (D-088). 운영자가 등록한 별칭만 인정한다.
model ClanAlias {
  id        String   @id @default(cuid())
  clanId    String
  /// 넥슨 `guild_name` 등 외부 표기. 대소문자·공백까지 그대로 둔다
  alias     String   @unique
  /// "nexon_guild" | "manual" — 어디서 온 표기인가
  source    String   @default("manual")
  createdAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

/// 운영자 변경 이력 (Phase 10).
///
/// 누가·언제·무엇을·이전 값·바뀐 값을 남긴다. **되돌릴 수 있어야 하기 때문이다.**
model AdminAuditLog {
  id         String   @id @default(cuid())
  /// 실행한 운영자 (계정이 지워져도 이력은 남기려고 FK를 걸지 않는다)
  userId     String
  userEmail  String
  /// "season.close" | "clan.update" | "roster.add" | "match.official" 등
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/// 운영 설정 (Phase 10).
///
/// 베타오픈 시각처럼 **운영자가 나중에 정하는 값**을 코드에 박지 않기 위한 저장소다.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/* ========================================================================== */
/* 3. 리그 · 시즌                                                              */
/* ========================================================================== */

/// 리그맵. 실제 맵 목록은 원본 조사 범위 밖이라 [미확인].
model GameMap {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  leagues LeagueMap[]
  matches Match[]
}

model League {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  /// 리그소개 HTML. **저장 전 서버에서 새니타이즈한다.**
  description   String?
  ownerUserId   String?
  /// 1 = 단일리그, 2 이상 = N부리그
  divisionCount Int      @default(1)
  /// 값 체계 [미확인] — 관측된 정상 리그는 1
  status        Int      @default(1)
  /// 공식 리그 배지. 원본 필드명은 [미확인] — 우리 계약에서 `official`로 확정
  official      Boolean  @default(false)
  /// "official" = 공식리그 | "independent" = 무소속리그 (D-107)
  ///
  /// 개인 기록은 이미 `LeaguePlayer(leagueId, playerId)` 단위로 완전히 분리돼 있다.
  /// 그래서 무소속리그는 **별도 League 행**이고, 두 리그의 rating·승패·랭킹·시즌 카드는
  /// 구조적으로 섞일 수 없다. 이 컬럼이 정하는 것은 **공개 범위 하나**다 —
  /// 무소속리그에서는 누적 kill/death/킬뎃을 사용자 화면에 내보내지 않는다.
  /// 경기 한 판의 K/D/A는 숨기지 않는다.
  category      String   @default("official")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// 3rd.supply의 리그 ID
  sourceLeagueId String?
  /// "sacloud" | "3rd.supply" | "mock" — 이 행이 어디서 왔는가 (D-116).
  /// `mock`은 개발용 시드다. **공개 화면에 내보내지 않는다.**
  origin        String   @default("sacloud")

  owner        User?               @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  maps         LeagueMap[]
  playerLimits LeaguePlayerLimit[]
  clans        LeagueClan[]
  players      LeaguePlayer[]
  seasons      Season[]
  matches      Match[]
  invitations  LeagueInvitation[]
  rankSnapshots RankSnapshot[]
  ratingConfigs RatingConfig[]
  rosterMemberships LeagueRosterMembership[]

  @@unique([sourceLeagueId])
  @@index([official, createdAt])
  @@index([origin])
}

/// 리그가 기록 대상으로 삼는 맵. 여기 없는 맵의 경기는 저장하지 않는다.
model LeagueMap {
  leagueId String
  mapId    String

  league League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  map    GameMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([leagueId, mapId])
}

/// 리그가 기록 대상으로 삼는 대전 인원 (5 또는 6).
model LeaguePlayerLimit {
  leagueId    String
  playerCount Int

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([leagueId, playerCount])
}

/// 시즌.
///
/// 사용자에게 보이는 흐름은 하나로 이어진다 (D-098):
///   Season 1 … Season 7 → Beta Season → Season 8 …
///
/// 세 종류를 `seasonType`으로 구분한다.
///   `legacy`   3rd.supply에서 이전된 과거 기록. **재계산하지 않는다**
///   `beta`     공개 베타 시즌. 기록은 보여 주되 다음 정식 시즌에 승계하지 않는다
///   `official` SACLOUD 정식 시즌
model Season {
  id        String    @id @default(cuid())
  leagueId  String
  /// 표시용 시즌 번호. **베타는 `0`이고 화면에 숫자로 쓰지 않는다** (`Beta Season`으로 표기)
  number    Int
  startedAt DateTime
  endedAt   DateTime?
  /// "active" | "closed"
  status    String    @default("active")
  /// "legacy" | "beta" | "official"
  seasonType String   @default("official")
  /// 이 시즌 기록이 3rd.supply에서 이전된 것인지
  imported  Boolean   @default(false)
  /// 확정된 과거 기록인가. `true`면 수집·래더 재계산이 이 시즌의 값을 건드리지 못한다
  frozen    Boolean   @default(false)
  createdAt DateTime  @default(now())

  league       League              @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerStats  LeaguePlayerSeason[]
  clanStats    LeagueClanSeason[]
  matches      Match[]
  rosterMemberships LeagueRosterMembership[]

  @@unique([leagueId, number])
  @@index([leagueId, number])
  // 화면 정렬은 번호가 아니라 **시작 시각** 기준이다. 베타(number 0)가 7과 8 사이에 와야 한다
  @@index([leagueId, startedAt])
}

/// 리그에 참여한 클랜. 래더·부리그·전적을 보유한다.
model LeagueClan {
  id       String @id @default(cuid())
  leagueId String
  clanId   String

  /// **표시 점수** — 화면·랭킹 정렬에 쓰는 값 (D-145).
  /// `internalRating` 에서 구성 보정을 더하고 활동 페널티를 뺀 정수다.
  rating   Int    @default(3000)
  /// **내부 Elo** — 실력 추정치 (D-145). 실수로 유지한다.
  /// 경기마다 반올림하면 제로섬이 깨진다.
  internalRating Float @default(3000)
  /// 최근 N경기 평균 본클랜원 수에서 나온 구성 보정 (상한 +50)
  compositionScore Float @default(0)
  /// 최근 20경기 평균 본클랜원 수 — compositionScore 의 입력값 (D-149).
  /// 화면은 이 값을 그대로 보여 준다. UI 에서 다시 계산하지 않는다.
  compositionMembers Float @default(0)
  /// 미참여로 쌓인 활동 페널티. **내부 Elo 는 건드리지 않는다**
  activityPenalty  Float @default(0)
  /// 마지막 래더 대상 경기 시각 — 미참여 일수 계산에 쓴다
  lastRatedAt      DateTime?
  /// 1 = 1부리그
  division Int    @default(1)
  win      Int    @default(0)
  lose     Int    @default(0)

  /// 배치고사 진행 중이면 true — 랭킹 미표시, 래더 자리에 `배치고사` 표기
  placement       Boolean @default(true)
  /// 배치고사로 치른 경기 수
  placementPlayed Int     @default(0)

  /// 0 = 대기/배치, 1 = 정상 (관측값). 그 외 코드는 [미확인]
  status           Int       @default(0)
  joinedAt         DateTime  @default(now())
  /// 클랜삭제 요청 시각. 1주일 뒤 자동 삭제(관측)
  deleteRequestedAt DateTime?
  deletesAt        DateTime?
  /// 추방 시각. 되돌릴 수 없고 재가입 불가(관측)
  expelledAt       DateTime?
  updatedAt        DateTime  @updatedAt

  /// 3rd.supply의 league_clan ID
  sourceLeagueClanId String?

  league       League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  clan         Clan               @relation(fields: [clanId], references: [id], onDelete: Cascade)
  seasonStats  LeagueClanSeason[]
  redMatches   Match[]            @relation("MatchRedClan")
  blueMatches  Match[]            @relation("MatchBlueClan")
  rosterMemberships LeagueRosterMembership[]

  @@unique([leagueId, clanId])
  @@unique([sourceLeagueClanId])
  // 클랜랭킹: 부리그별 래더 내림차순
  @@index([leagueId, division, rating(sort: Desc)])
}

/// 리그에 참여한 플레이어. 개인 래더와 누적 스탯을 보유한다.
model LeaguePlayer {
  id       String  @id @default(cuid())
  leagueId String
  playerId String
  /// 경기 당시가 아니라 **현재** 소속 클랜 (표시용)
  clanId   String?

  /// 통합 래더 = baseRating + 무기별 ratingDelta 합.
  /// 무기 분리가 통합 래더 값을 바꾸면 안 된다 (LADDER_IMPLEMENTATION_SPEC 6장).
  /// 정렬 인덱스 때문에 유지 컬럼으로 두되, 정합성 검사를 테스트로 고정한다.
  /// **표시 점수** — 화면·랭킹 정렬에 쓰는 값 (D-145).
  /// `3000 + (internalRating − 3000) × 신뢰도 × 3.5` 에 승률 자격선과 활동 페널티를 적용한 정수다.
  rating      Int @default(3000)
  /// 배치고사 종료 시점의 시작 래더. 이후 증감은 무기별 delta에 누적된다.
  baseRating  Int @default(3000)
  /// **내부 Elo** — 실력 추정치 (D-145). 실수로 유지한다.
  /// 표시 점수와 달리 신뢰도·자격선·미참여 감점의 영향을 받지 않는다.
  internalRating Float @default(3000)
  /// 미참여로 쌓인 활동 페널티. 표시 점수에서만 뺀다
  activityPenalty Float @default(0)
  /// 마지막 래더 대상 경기 시각
  lastRatedAt     DateTime?

  win      Int @default(0)
  lose     Int @default(0)
  kill     Int @default(0)
  death    Int @default(0)
  assist   Int @default(0)
  headshot Int @default(0)
  mvpCount Int @default(0)

  placement       Boolean @default(true)
  placementPlayed Int     @default(0)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 3rd.supply의 league_player ID
  sourceLeaguePlayerId String?

  league      League                   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player      Player                   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clan        Clan?                    @relation("LeaguePlayerClan", fields: [clanId], references: [id], onDelete: SetNull)
  weaponStats LeaguePlayerWeaponStat[]
  seasonStats LeaguePlayerSeason[]

  @@unique([leagueId, playerId])
  @@unique([sourceLeaguePlayerId])
  // 개인랭킹: 래더 내림차순
  @@index([leagueId, rating(sort: Desc)])
}

/// 무기별 분리 기록 (0 = 라이플, 1 = 스나이퍼).
///
/// `LADDER_IMPLEMENTATION_SPEC` 6장: `rating_update`는 무기와 무관하게 한 공식으로 계산하고,
/// 그 값을 **해당 경기에서 쓴 무기 쪽 delta에만** 누적한다.
/// 화면에는 무기별로 kills·deaths·KD%·wins·losses·win%·rating delta·weapon rank를 보여준다.
model LeaguePlayerWeaponStat {
  leaguePlayerId String
  /// 0 = 라이플, 1 = 스나이퍼
  weapon         Int

  ratingDelta Int @default(0)
  /// 그 무기로 뛴 경기 전부 (KDA 를 모르는 경기 포함)
  games          Int @default(0)
  /// 그중 K/D/A 를 아는 경기. 킬·데스·어시의 **분모**다 (D-149)
  knownStatGames Int @default(0)
  win         Int @default(0)
  lose        Int @default(0)
  kill        Int @default(0)
  death       Int @default(0)
  assist      Int @default(0)
  headshot    Int @default(0)

  updatedAt DateTime @updatedAt

  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@id([leaguePlayerId, weapon])
  @@index([weapon, ratingDelta(sort: Desc)])
}

/* -------------------------- 시즌 스냅샷 (지난시즌) -------------------------- */

/// 시즌 종료 시점에 고정되는 개인 성적. **hard delete 금지** (CLAUDE.md 3-A 7번).
model LeaguePlayerSeason {
  id             String @id @default(cuid())
  leaguePlayerId String
  seasonId       String
  /// 조회 편의를 위한 비정규화. `Season.number`와 항상 같아야 한다.
  season         Int

  rank      Int?
  rankCount Int?

  /* SACLOUD가 계산한 시즌 카드는 이 값들이 **항상 있다**.
     과거(3rd.supply) 카드는 시즌마다 제공 필드가 달라서 **없을 수 있다** — 예를 들어
     시즌 4는 승률·킬뎃만 주고 승/패/킬/데스를 주지 않는다.
     그때 0을 넣으면 화면에 `0승 0패 · 승률 56.9%` 같은 **거짓말**이 남는다.
     그래서 nullable이다. 없으면 `null`, 화면에는 `알수없음` (D-106). */
  rating    Int?
  win       Int?
  lose      Int?
  kill      Int?
  death     Int?

  /* 아래는 **원본에 있을 때만** 채운다. 없으면 `null`로 남긴다 — 역산하지 않는다 (D-099).
     승률·킬뎃은 승패·킬데스로 계산할 수 있지만, 원본이 준 값과 반올림이 달라질 수 있어
     원본 값을 그대로 보존한다. */
  assist       Int?
  headshot     Int?
  winRate      Float?
  kdRate       Float?
  /// 평균킬 (원본 `kill_per_match`)
  killPerMatch Float?
  mvpCount     Int?
  /// 그 시즌 시점의 소속·부리그·닉네임. 지금 값이 아니라 **그때의 값**이다
  clanNameAtSeason String?
  divisionAtSeason Int?
  nicknameAtSeason String?
  /// 3rd.supply 쪽 식별자. 닉네임 자동 병합을 하지 않기 위한 근거로 보존한다 (D-100)
  legacyPlayerId       String?
  legacyLeaguePlayerId String?
  /// 어디서 왔는지 ("3rd.supply" 등). SACLOUD가 계산한 행은 `null`
  source    String?

  /// 이 행이 3rd.supply에서 이전된 것인지. true면 값을 재계산하지 않는다.
  imported  Boolean  @default(false)
  createdAt DateTime @default(now())

  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)
  seasonRef    Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([leaguePlayerId, seasonId])
  @@index([seasonId, rating(sort: Desc)])
}

/// 시즌 종료 시점에 고정되는 클랜 성적.
/// 개인과 컬럼 구성이 다른지는 [미확인] — 계약상 동일 형태로 둔다.
model LeagueClanSeason {
  id           String @id @default(cuid())
  leagueClanId String
  seasonId     String
  season       Int

  rank      Int?
  rankCount Int?
  rating    Int
  division  Int @default(1)
  win       Int @default(0)
  lose      Int @default(0)

  /* 원본에 있을 때만 채운다 (D-099) */
  winRate           Float?
  clanNameAtSeason  String?
  legacyClanSlug    String?
  source            String?

  imported  Boolean  @default(false)
  createdAt DateTime @default(now())

  leagueClan LeagueClan @relation(fields: [leagueClanId], references: [id], onDelete: Cascade)
  seasonRef  Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([leagueClanId, seasonId])
  @@index([seasonId, division, rating(sort: Desc)])
}

/// 리그 관리 — 클랜 초대. 초대링크 복사에 사용한다(관측).
model LeagueInvitation {
  id        String    @id @default(cuid())
  leagueId  String
  clanId    String
  division  Int       @default(1)
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  acceptedAt DateTime?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
}

/* ========================================================================== */
/* 4. 매치 · 스탯                                                              */
/* ========================================================================== */

/// 한 경기.
///
/// 매치 ID는 원본 관측 규칙(`YYMMDDHHmmss` + 6자리, 총 18자리)을 그대로 쓴다.
/// 승패·래더증감은 **보는 쪽에 따라 달라지므로** 여기 저장하지 않고
/// 진영별 스냅샷에서 조회 시 계산한다.
model Match {
  /// 18자리 숫자 문자열
  id          String   @id
  leagueId    String
  seasonId    String?
  mapId       String
  playerCount Int
  startAt     DateTime
  /// 원본이 종료 시각을 주지 않으면 null (넥슨은 date_match 하나뿐) — D-034
  endAt       DateTime?
  /// 플레이 시간(초). endAt-startAt과 다를 수 있어 원본값을 그대로 보관한다.
  /// 원본에 없으면 null = 알 수 없음 (D-034)
  playTime    Int?

  /// 선공 진영이 블루면 true (원본 표기: 선레드 / 선블루). 정확한 의미는 [미확인]
  /// **false를 기본값으로 쓰지 않는다.** 모르면 null이다 (D-034)
  blueFirst   Boolean?
  /// "red" | "blue"
  winnerSide  String
  mvpPlayerId String?

  redLeagueClanId  String
  blueLeagueClanId String

  /* --- 경기 시점 스냅샷. 승격·강등 후에도 과거 경기가 오염되면 안 된다 --- */
  /// LADDER_IMPLEMENTATION_SPEC 4장 — 필수
  redDivisionAtMatch  Int
  blueDivisionAtMatch Int
  redRatingBefore     Int?
  blueRatingBefore    Int?
  redPlacement        Boolean @default(false)
  bluePlacement       Boolean @default(false)
  /// 클랜 래더 증감 (진영별). 배치고사면 0.
  redRatingUpdate     Int?
  blueRatingUpdate    Int?

  /* 원본(3rd.supply)이 보여 준 클랜 점수 — 위 값과 분리한다 (D-153).
     위는 우리가 계산한 값이고, 아래는 원본이 그 경기에 실제로 보여 준 값이다. */
  redSourceRating       Int?
  blueSourceRating      Int?
  redSourceRatingUpdate  Int?
  blueSourceRatingUpdate Int?

  /* --- 출처 추적 --- */
  /// "3rd.supply" | "nexon" | "sacloud" | "mock"
  /// `mock`은 개발용 시드 데이터다. 실제 기록과 섞이지 않게 출처를 남긴다.
  origin       String   @default("sacloud")
  sourceMatchId String?

  /// **공식 통계 반영 대상인가** (Phase 9 · D-079 · D-080).
  ///
  /// `false`면 **참고 기록**이다 — 기록실에는 그대로 보이지만
  /// 시즌 승패·킬뎃·평균킬·MVP·개인 래더·클랜 래더·랭킹에 **전혀 반영하지 않는다.**
  /// 양 팀 모두 본클랜원이 3명 미만인 경기가 여기 해당한다. **경기를 지우지는 않는다.**
  official     Boolean @default(true)

  /// 재구성으로 만든 경기의 **확인 수준** (Phase 9 · D-068).
  /// "5v4" 처럼 몇 명을 확인했는지, 그리고 그 확신 등급을 화면에 그대로 보여 준다.
  /// 우리가 모르는 것을 아는 척하지 않기 위한 값이다.
  participantCompleteness String?
  /// "high" | "medium" | "low"
  evidenceConfidence      String?
  ingestedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  league    League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season    Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  map       GameMap     @relation(fields: [mapId], references: [id])
  redClan   LeagueClan  @relation("MatchRedClan", fields: [redLeagueClanId], references: [id], onDelete: Cascade)
  blueClan  LeagueClan  @relation("MatchBlueClan", fields: [blueLeagueClanId], references: [id], onDelete: Cascade)
  mvpPlayer Player?     @relation("MatchMvp", fields: [mvpPlayerId], references: [id], onDelete: SetNull)
  stats     MatchPlayerStat[]

  @@unique([origin, sourceMatchId])
  // 기록실: 리그별 최신순
  @@index([leagueId, startAt(sort: Desc)])
  @@index([redLeagueClanId, startAt(sort: Desc)])
  @@index([blueLeagueClanId, startAt(sort: Desc)])
  @@index([seasonId])
}

/// 경기 참가자 한 명의 기록 + 래더 계산 재현 정보.
///
/// 결측 처리: 상대 클랜 소속 플레이어는 딜량·헤드샷을 알 수 없다.
/// **추측해서 채우지 않고 `null`로 저장**하고 UI에서 `알수없음`으로 표기한다.
model MatchPlayerStat {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  /// "red" | "blue"
  side     String

  kill     Int?
  death    Int?
  assist   Int?
  /// 결측 가능 — `알수없음`
  headshot Int?
  /// 결측 가능 — `알수없음`
  damage   Int?
  /// 0 = 라이플, 1 = 스나이퍼 (라인업에 `[S]` 표기).
  /// 넥슨 Open API는 무기를 주지 않는다 → null = 알 수 없음 (D-034)
  weapon   Int?
  /// 탈주. **모르면 null이다.** false는 "탈주하지 않았다"는 실제 정보다 (D-034)
  dropout  Boolean?
  /// MVP. 위와 같다 — 모르면 null (D-034)
  mvp      Boolean?

  /// 이 경기에서의 역할 — "member"(본클랜원) | "mercenary"(용병) (Phase 9 · D-073).
  /// 용병도 개인 기록과 개인 래더를 정상적으로 받는다.
  /// 공식전 인정(양 팀 본클랜원 3명)에만 쓰이지 않을 뿐이다.
  participantRole String @default("member")
  /// 경기 시점 **원소속 클랜**. 용병이면 뛴 팀과 다르고, 없으면 null.
  /// **이 클랜의 래더는 이 경기로 변하지 않는다** (D-075)
  rosterLeagueClanId String?

  /* --- 경기 당시 소속 스냅샷 (D-131) ---------------------------------------
     기록실·경기 상세는 **그 경기를 했을 당시** 소속을 보여 준다.
     현재 소속(`Player.clanId` / `LeaguePlayer.clanId`)을 join 해서 과거 화면에
     뿌리면 선수가 이적하는 순간 과거 기록이 통째로 바뀐다. 그래서 값을 박아 둔다.
     리그 밖 클랜일 수 있으므로 이름은 항상 남기고 우리 클랜 연결은 있을 때만 남긴다. */
  /// 경기 당시 클랜명 (원본 표기 그대로). 근거가 없으면 null = 알 수 없음
  matchTimeClanName         String?
  /// 그 클랜이 우리 리그 클랜과 연결됐으면 그 id. 외부 클랜이면 null
  matchTimeLeagueClanId     String?
  matchTimeClanSlug         String?
  matchTimeClanMarkBgUrl    String?
  matchTimeClanMarkFrontUrl String?
  /// 근거의 출처 — "nexon-detail" | "roster" | "supply-lineup"
  matchTimeClanSource       String?
  /// 그 근거를 관측한 시각
  matchTimeClanObservedAt   DateTime?
  /// "high" | "medium" | "low"
  matchTimeClanConfidence   String?

  /* --- 래더 재현 정보 (LADDER_IMPLEMENTATION_SPEC 5장) --- */
  /// 배치고사 중이면 null (래더 자리에 `배치고사` 표기)
  ratingBefore Int?
  /// 배치고사 경기의 rating_update는 0
  ratingUpdate Int?
  ratingAfter  Int?
  /// 경기 시점 division 스냅샷 — 필수
  playerDivisionAtMatch   Int
  opponentDivisionAtMatch Int
  /// 상대 팀 선수들의 경기 직전 통합 개인 래더 평균 (공식 입력 Ro)
  opponentAvgRating Int?
  /// 사용된 K값 / 승리 배수 — 공식이 바뀌어도 당시 계산을 재현하기 위해 보관
  kUsed          Float?
  multiplierUsed Float?
  /// 계산에 쓰인 공식 버전. 이전 기록은 "3rd.supply-imported"로 표기해
  /// **추정 공식으로 덮어쓰지 않는다** (CLAUDE.md 3-A 2번)
  formulaVersion String?
  isPlacement    Boolean @default(false)

  /* --- 원본(3rd.supply) 점수 — 우리 계산과 **완전히 분리한다** (D-153) -------
     위의 `ratingBefore` / `ratingUpdate` 는 **우리가 계산한** 값이다(D-145).
     아래는 3rd.supply 가 그 경기에 실제로 보여 준 값이다. 둘을 한 칸에 담으면
     어느 쪽 숫자인지 알 수 없게 되고, 한 번 섞이면 되돌릴 수 없다.

     시즌7 베타의 **운영 화면은 아래 source 값을 쓴다.** 우리 공식(D-145)은
     코드와 컬럼을 남겨 두되 화면에 적용하지 않는다 — 미러가 안정된 뒤
     별도 검증을 거쳐 전환한다. */
  /// 3rd.supply 경기 상세 화면이 그 선수 자리에 **표시하는** 래더.
  ///
  /// **"경기 당시" 값이 아니다.** 실측으로 확인했다 — 한 선수의 162경기에서
  /// 이 값이 전부 같았다. 원본은 **수집 시점의 현재 래더**를 모든 행에 그대로 붙인다.
  /// `opponent.rating` / `opponent.division` 도 클랜별로 값이 하나뿐이라 같은 성격이다.
  ///
  /// 원본 화면을 그대로 재현하려고 담아 둘 뿐이다.
  /// **래더 재현의 입력으로 쓰면 안 된다** — 경기 시점 정보가 아니다.
  sourceRating      Int?
  /// 3rd.supply 의 그 경기 증감. **이건 경기마다 다르다** — 진짜 증감이 맞다.
  /// 원본값 그대로 보관하고 재계산하지 않는다 (3-A 2번)
  sourceRatingDelta Int?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId, matchId])
  @@index([matchId, side])
}

/* ========================================================================== */
/* 5. 랭킹 스냅샷 (1시간 주기 배치)                                             */
/* ========================================================================== */

/// 배치가 만들어 두는 랭킹 결과. 조회는 이 스냅샷을 읽는다.
model RankSnapshot {
  id          String   @id @default(cuid())
  leagueId    String
  /// "clan" | "player"
  kind        String
  /// 개인랭킹은 부리그 구분이 없어 null
  division    Int?
  seasonNumber Int
  generatedAt DateTime @default(now())
  /// 정렬 완료된 랭킹 행 배열
  payload     Json

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, kind, division, seasonNumber])
  @@index([generatedAt])
}

/* ========================================================================== */
/* 6. 게시판                                                                   */
/* ========================================================================== */

model BoardCategory {
  slug   String  @id
  name   String
  /// 공지 카테고리는 목록 상단에 고정 노출된다
  notice Boolean @default(false)
  order  Int     @default(0)

  boards Board[]

  @@index([order])
}

model Board {
  id           String @id @default(cuid())
  categorySlug String
  title        String
  /// 저장된 HTML. **저장 전 서버에서 새니타이즈한다.**
  content      String

  /// 비로그인 익명 글이면 null
  userId       String?
  /// 익명 글의 자동 별칭
  anonAlias    String?
  /// 비로그인 글 삭제용 비밀번호 해시. 평문 저장 금지.
  anonPasswordHash String?
  /// 0 = 일반(닉네임 공개), 그 외 = 익명. 0 이외 값 체계는 [미확인]
  discloseType Int    @default(0)
  /// 0 = 웹, 1 = 앱
  writerApp    Int    @default(0)

  viewCount    Int     @default(0)
  likeCount    Int     @default(0)
  dislikeCount Int     @default(0)
  commentCount Int     @default(0)
  hasImage     Boolean @default(false)
  /// 공지 고정 행 여부. 카테고리의 `notice`와 별개로 **글 단위**로도 고정할 수 있다
  /// (계약 `BoardListItem.notice`가 행마다 내려온다).
  notice       Boolean @default(false)

  /// "sacloud" | "mock" — 이 행이 어디서 왔는가 (D-116).
  /// `mock`은 개발용 시드다. **공개 화면에 내보내지 않는다.**
  origin     String    @default("sacloud")

  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastEdited DateTime?

  category BoardCategory @relation(fields: [categorySlug], references: [slug])
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments Comment[]

  // 목록: 카테고리별 최신순 (커서 페이지네이션)
  @@index([categorySlug, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  // 실시간 인기게시글
  @@index([likeCount(sort: Desc), createdAt(sort: Desc)])
  // 공개 목록: 시드 제외 + 최신순
  @@index([origin, createdAt(sort: Desc)])
}

/// 댓글. 원본은 대댓글 1단계까지만 허용한다(관측).
model Comment {
  id       String  @id @default(cuid())
  boardId  String
  /// null이면 최상위 댓글. 대댓글은 1단계까지만 — 부모의 parentId는 반드시 null이어야 한다.
  parentId String?
  content  String

  userId           String?
  anonAlias        String?
  anonPasswordHash String?
  discloseType     Int     @default(0)
  writerApp        Int     @default(0)

  likeCount    Int @default(0)
  dislikeCount Int @default(0)

  /// true면 **행은 남기고 내용만 가린다** (원본 관측). 물리 삭제하지 않는다.
  deleted    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastEdited DateTime?

  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([parentId])
}

/// 추천/비추천. 한 대상에 한 투표자당 1행.
/// 비로그인 투표는 `voterKey`에 익명 식별자(해시)를 넣는다.
model Vote {
  id         String @id @default(cuid())
  /// "board" | "comment"
  targetType String
  targetId   String
  voterKey   String
  /// -1 = 비추천, 0 = 취소, 1 = 추천. 정확한 값 체계는 [미확인]
  type       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([targetType, targetId, voterKey])
  @@index([targetType, targetId])
}

model Upload {
  id        String   @id @default(cuid())
  url       String
  ownerKey  String
  userId    String?
  byteSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ownerKey])
}

/* ========================================================================== */
/* 7. 마이그레이션 · 수집 (CLAUDE.md 3-A)                                       */
/* ========================================================================== */

/// **원본 응답 보관소. 어떤 경우에도 버리지 않는다.**
///
/// 변환 로직이나 래더 로직에 오류가 나와도 여기서 재변환·재검증할 수 있어야 한다
/// (CLAUDE.md 3-A 1번). 같은 대상을 다시 받아도 `migrationVersion`이 다르면 별도 행으로 쌓인다.
model RawImport {
  id       String @id @default(cuid())
  /// "3rd.supply" | "nexon"
  source   String
  /// 호출한 엔드포인트 경로
  endpoint String
  /// 원본 쪽 식별자 (클랜 slug, 매치 ID 등)
  sourceId String
  /// 요청 파라미터 — 재현에 필요하다
  /// **API 키를 저장하지 않는다.** 키는 헤더로만 나가며 여기에 담기지 않는다.
  requestParams Json?
  httpStatus    Int?
  /// 응답 본문 원형. 가공하지 않는다.
  raw           Json
  fetchedAt     DateTime @default(now())
  /// 수집 파이프라인 버전
  migrationVersion String

  /// 응답 본문의 내용 해시(sha256). **같은 내용이면 새 행을 만들지 않고**
  /// `fetchCount`/`lastFetchedAt`만 올린다. 내용이 달라지면 새 행을 추가한다(append-only).
  /// 유니크에 포함된 이유: 30일 갱신 재수집이 기존 원본을 덮어쓰면 원본 보존이 깨진다.
  contentHash   String   @default("")
  firstFetchedAt DateTime @default(now())
  lastFetchedAt  DateTime @default(now())
  fetchCount     Int      @default(1)

  /// 이 원본이 어떤 로컬 엔티티로 변환됐는지 (변환 전이면 null)
  normalizedAt DateTime?

  @@unique([source, endpoint, sourceId, migrationVersion, contentHash])
  @@index([source, endpoint, fetchedAt])
  @@index([source, endpoint, sourceId])
  @@index([normalizedAt])
}

/// 3rd.supply의 **시즌 최종 요약 스냅샷** (Legacy).
///
/// 목표는 원본 복제가 아니다. "내가 과거 시즌에 승률 몇 %, 킬뎃 몇이었는지"를
/// 사용자가 새 사이트에서 확인할 수 있는 수준까지만 보존한다.
/// 개별 경기·참가자·경기별 rating_update·게시판은 **이관 대상이 아니다.**
///
/// 운영 데이터와 섞지 않는다
/// - `LeaguePlayerSeason`(신규)과 **별도 테이블**이다. 조인하지 않는다.
/// - **신규 래더 공식으로 재계산하지 않는다.** 원본에 적힌 값을 그대로 둔다
///   (CLAUDE.md 3-A 2번).
/// - 원본에 없는 값은 `null`이다. **추측하거나 역산하지 않는다.**
///   승률만 있으면 `winRate`만 채우고 `wins`/`losses`는 null로 둔다.
///
/// 동일인 판정
/// - 닉네임을 영구 ID로 보지 않는다. `sourcePlayerId`가 있으면 그것을 보존한다.
/// - 닉네임만으로 현재 사용자와 **자동 병합하지 않는다.** 연결은 별도 검증 절차로 미룬다.
model LegacyPlayerSeason {
  id     String @id @default(cuid())
  /// "3rd.supply"
  source String @default("3rd.supply")

  /// 원본의 안정적인 플레이어 식별자. 페이지에서 얻지 못하면 null.
  sourcePlayerId String?
  /// 화면에 보이던 닉네임. **식별자가 아니다** (바뀔 수 있다).
  nickname       String

  /**
   * 지난시즌은 **리그마다 따로** 존재한다 (`/league/:slug/player/:id/season`).
   * 리그를 빼면 같은 시즌 번호의 다른 리그 기록이 서로 덮어쓴다.
   * 사용자 명세에는 없었지만 정확성에 필요해 넣었다.
   */
  leagueSlug String?
  season     Int
  division   Int?
  clanName   String?

  wins    Int?
  losses  Int?
  /// 승률 %. 원본이 승/패 없이 승률만 보여주면 이것만 채운다.
  winRate Float?

  kills  Int?
  deaths Int?
  /// 킬뎃 %. 원본 표기를 그대로 담는다 (`킬/(킬+데스)×100`).
  kd     Float?

  finalRating Int?
  finalRank   Int?
  /// 순위의 모집단 (원본이 "360명중 1위" 형태로 보여준다). 없으면 null.
  rankCount   Int?

  /// 어느 페이지에서 가져왔는지. 나중에 원본과 대조할 때 쓴다.
  sourceUrl   String?
  /// 화면에서 읽은 원문. 변환이 틀려도 여기서 다시 만들 수 있다 (CLAUDE.md 3-A 1번).
  rawSnapshot Json?

  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /**
   * 중복 방지 키. import 시 계산한다.
   * `<source>|<sourcePlayerId ?? "nick:"+nickname>|<leagueSlug ?? "-">|<season>`
   *
   * 왜 컬럼을 따로 두나: Postgres의 유니크 인덱스는 NULL을 서로 다른 값으로 본다.
   * `sourcePlayerId`나 `leagueSlug`가 비어 있으면 복합 유니크로는 중복이 걸러지지 않는다.
   * 같은 CSV를 여러 번 넣어도 한 행만 남아야 하므로 키를 명시적으로 만든다.
   */
  dedupeKey String @unique

  @@index([nickname])
  @@index([sourcePlayerId])
  @@index([leagueSlug, season])
}

/// Legacy 자동 수집 작업 (`pnpm legacy:collect`).
///
/// 5,000명은 한 번에 끝나지 않는다. 중간에 멈춰도 **이어서 할 수 있어야** 한다.
/// 그래서 진행 상황을 DB에 남긴다 (CLAUDE.md 3-A 4번: 일회성 스크립트 금지).
model LegacyCollectionJob {
  id     String @id @default(cuid())
  /// "3rd.supply"
  source String @default("3rd.supply")
  /// 수집 대상 리그. 현재는 서플라이공식리그(`supply`)뿐이다.
  leagueSlug String @default("supply")

  /// "running" | "done" | "stopped" | "blocked"
  /// `blocked` = 접근 통제(WAF/CAPTCHA/403)를 만나 **우회하지 않고 스스로 멈춘 상태**
  status String @default("running")

  totalPlayers     Int @default(0)
  processedPlayers Int @default(0)
  successPlayers   Int @default(0)
  failedPlayers    Int @default(0)
  rowsCreated      Int @default(0)

  /// 마지막으로 처리한 플레이어. 재개 지점.
  lastPlayerId String?
  /// 멈춘 이유 (blocked/stopped일 때)
  stopReason   String?

  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  players LegacyCollectionPlayer[]

  @@index([status, startedAt])
}

/// 플레이어 한 명의 수집 결과. 이미 끝난 사람은 재실행 때 건너뛴다.
model LegacyCollectionPlayer {
  id    String @id @default(cuid())
  jobId String

  sourcePlayerId String
  nickname       String?

  /// "pending" | "success" | "not_found" | "parse_failed" | "blocked" | "error"
  status String @default("pending")
  /// 재시도 횟수. 일시 오류(5xx·타임아웃)만 제한적으로 재시도한다.
  attempts    Int  @default(0)
  rowsCreated Int  @default(0)

  /// "http_404" | "http_403" | "http_429" | "waf_captcha" | "timeout" | "parse" | ...
  errorType    String?
  errorMessage String?
  httpStatus   Int?

  /// 처리에 걸린 시간(ms). 평균 산출용.
  durationMs Int?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  job LegacyCollectionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourcePlayerId])
  @@index([jobId, status])
  @@index([sourcePlayerId])
}

/// 원본 ID ↔ 로컬 ID 매핑. 엔티티 컬럼(`source*Id`)과 중복이지만,
/// 아직 로컬 엔티티가 없는 단계에서도 대조가 가능해야 해서 별도로 둔다.
model SourceMapping {
  id         String @id @default(cuid())
  source     String
  /// "player" | "clan" | "league" | "league_clan" | "league_player" | "match"
  entityType String
  sourceId   String
  localId    String

  createdAt DateTime @default(now())

  @@unique([source, entityType, sourceId])
  @@index([source, entityType, localId])
}

/// 중단 후 재개 가능한 파이프라인의 진행 상태 (CLAUDE.md 3-A 4번).
/// 일회성 스크립트를 금지하고, 커서를 DB에 남겨 언제든 이어받게 한다.
model ImportJob {
  id      String @id @default(cuid())
  source  String
  /// 작업 단위 키 (예: "clan:abc123:matches")
  jobKey  String
  /// "pending" | "running" | "done" | "failed"
  status  String @default("pending")
  /// 다음에 이어받을 위치
  cursor  String?
  /// 처리 완료 건수 — 숫자 대조 검증에 쓴다 (CLAUDE.md 3-A 6번)
  processed Int   @default(0)
  /// 원본이 알려준 전체 건수 (모르면 null)
  expected  Int?

  attempts    Int       @default(0)
  lastError   String?
  /// exponential backoff — 이 시각 전에는 재시도하지 않는다
  nextRetryAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  migrationVersion String

  @@unique([source, jobKey, migrationVersion])
  @@index([status, nextRetryAt])
}

/// 개별 항목 실패 기록. **실패를 성공으로 처리하지 않기 위해** 남긴다.
model ImportFailure {
  id        String   @id @default(cuid())
  source    String
  jobKey    String
  sourceId  String?
  reason    String
  detail    Json?
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([source, jobKey])
  @@index([resolvedAt])
}

/// 마이그레이션 검증 결과. "수집 완료" 로그가 아니라 **숫자 대조**로 판정한다
/// (CLAUDE.md 3-A 6번).
model MigrationCheck {
  id        String   @id @default(cuid())
  /// 검사 이름 (예: "match_count:league:xxx")
  name      String
  /// 원본에서 센 값
  expected  Int
  /// 우리 DB에서 센 값
  actual    Int
  passed    Boolean
  note      String?
  checkedAt DateTime @default(now())

  migrationVersion String

  @@index([migrationVersion, passed])
  @@index([name])
}

/* ========================================================================== */
/* 7-N. 넥슨 Open API 수집 스테이징 (Phase 8)                                   */
/* ========================================================================== */
//
// 흐름은 반드시 아래 순서를 지킨다 (`docs/NEXON_INGEST_SPEC.md` 2장).
//   Nexon 응답 → RawImport → normalize → NexonMatch/NexonMatchParticipant
//              → validate → projection rule → Match / MatchPlayerStat
// 넥슨 응답을 운영 `Match`에 **바로 넣지 않는다.**

/// 넥슨 계정 식별자(ouid) 한 개. **ouid만으로 영구 동일인을 가정하지 않는다.**
///
/// 넥슨은 "게임 콘텐츠 변경으로 ouid가 변경될 수 있다"고 명시했고, 닉네임도 영구 식별자가
/// 아니다. 그래서 `Player` 연결은 **근거가 있을 때만** 하고, 근거가 부족하면
/// `NexonIdentityCandidate`로 남겨 사람이 판단하게 한다 (D-036).
model NexonIdentity {
  id       String  @id @default(cuid())
  ouid     String  @unique
  playerId String?

  /// "unresolved" | "active" | "superseded" | "conflicted"
  /// 기본값은 unresolved — ouid를 알아냈다고 해서 누구인지 아는 것은 아니다.
  status   String  @default("unresolved")

  /// 마지막으로 관측된 닉네임 (스냅샷, 식별자가 아니다)
  userName String?

  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  /// 넥슨에서 마지막으로 값을 확인한 시각 (신선도 정책 기준)
  lastVerifiedAt DateTime?

  linkedAt   DateTime?
  /// 연결 근거. 자동 연결을 금지하므로 사람이 남긴 사유가 들어간다
  linkReason String?
  linkedBy   String?

  /// 같은 사람의 더 새로운 ouid가 확인됐을 때. **행을 지우지 않는다**
  supersededByOuid String?
  supersededAt     DateTime?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player     Player?                  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  candidates NexonIdentityCandidate[] @relation("CandidateIdentity")

  @@index([status])
  @@index([playerId])
  @@index([userName])
}

/// 닉네임 관측 이력. 매치 상세는 참가자 ouid를 주지 않고 닉네임만 준다.
///
/// 닉네임 → 플레이어 해석의 **보조 자료**일 뿐이다. 여기 있는 값으로 자동 병합하지 않는다.
model NexonNickname {
  id            String @id @default(cuid())
  nickname      String
  /// 대소문자 무시 비교용
  nicknameLower String
  /// 관측 출처가 매치 상세면 ouid를 모른다 → null
  ouid          String?
  /// `ouid ?? "-"`. Postgres는 NULL을 서로 다른 값으로 보므로 유니크에 NULL을 넣을 수 없다
  /// (legacy `dedupeKey`와 같은 이유)
  identityKey   String
  source        String @default("nexon")
  observations  Int    @default(1)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([nicknameLower, identityKey])
  @@index([ouid])
  @@index([nicknameLower])
}

/// 신원 연결 **후보**. 자동 승인 경로는 만들지 않는다 (D-036).
model NexonIdentityCandidate {
  id   String @id @default(cuid())
  ouid String

  /// 연결 후보 플레이어 (있으면)
  targetPlayerId String?
  /// ouid 변경 후보 — 같은 사람으로 의심되는 다른 ouid
  targetOuid     String?

  /// "nickname_match" | "ouid_change" | "manual"
  reason   String
  /// 판단 근거 원문 (관측된 닉네임·시각·건수 등)
  evidence Json?

  /// "open" | "accepted" | "rejected"
  status String @default("open")

  /// 중복 후보 방지. `ouid|targetPlayerId ?? "-"|targetOuid ?? "-"|reason`
  candidateKey String @unique

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  note       String?

  identity NexonIdentity @relation("CandidateIdentity", fields: [ouid], references: [ouid], onDelete: Cascade)
  player   Player?       @relation(fields: [targetPlayerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([ouid])
  @@index([targetPlayerId])
}

/// 넥슨 매치 스테이징. 운영 `Match`와 **분리**된 표다.
///
/// `matchType`은 원본 그대로 보존한다. 클랜전이 아니라는 이유로 버리거나 바꾸지 않는다.
/// 사용 여부 판단은 투영 규칙에서만 한다 (G 결정).
model NexonMatch {
  id            String @id @default(cuid())
  source        String @default("nexon")
  /// 넥슨 원본 match_id. **내부 `Match.id`로 쓰지 않는다** (B 결정)
  sourceMatchId String

  matchMode String?
  matchType String?
  dateMatch DateTime?
  matchMap  String?
  participantCount Int?

  /// 이 경기를 처음 발견한 ouid (목록 조회 주체). 원본 전체는 RawImport에 있다
  discoveredByOuid String?
  /// 발견 경로. 넥슨 목록에서 나왔으면 null, 3rd.supply 스냅샷 seed 면 "3rd.supply" (D-127).
  /// **사실값의 출처가 아니다** — 맵·참가자는 언제나 넥슨 /match-detail 응답에서 온다
  discoverySource  String?

  listRawImportId   String?
  detailRawImportId String?
  detailFetchedAt   DateTime?

  /// "pending" | "valid" | "invalid"
  validationStatus String @default("pending")
  validationIssues Json?

  /// "pending" | "projected" | "skipped" | "blocked"
  projectionStatus String  @default("pending")
  projectionReason String?
  /// roster 기반 재구성 판정 결과 요약 (관측 수 · 확정 참가자 수 · 팀별 인원 등).
  /// **증거를 남기기 위한 것**이지 계산 결과가 아니다 (Phase 8.2)
  reconstruction   Json?
  reconstructedAt  DateTime?

  /// 확인 수준 (Phase 9 · D-068 · D-074).
  ///
  /// 공식전 인정 기준은 **본클랜원** 3명씩이지만(D-071), 확인 수준은 **출전자 전원** 기준이다.
  /// 두 숫자를 따로 남겨야 "본클랜원 3 + 용병 2"와 "본클랜원 5"를 구분할 수 있다.
  winnerMembersConfirmed      Int?
  loserMembersConfirmed       Int?
  winnerMercenariesConfirmed  Int?
  loserMercenariesConfirmed   Int?
  /// 본클랜원 + 용병 (실제 확인된 출전 인원)
  winnerConfirmed             Int?
  loserConfirmed              Int?
  observationParticipantCount Int?
  detailParticipantCount      Int?
  /// "5v5" 처럼 사람이 읽을 수 있는 확인 수준 (출전자 전원 기준)
  participantCompleteness     String?
  /// "high" | "medium" | "low"
  reconstructionConfidence    String?
  /// 공식 통계 반영 대상인가 (D-079). false면 참고 기록이다
  official                    Boolean @default(true)

  /// 투영된 운영 매치의 내부 ID (FK를 걸지 않는다 — 스테이징은 외부 데이터의 거울이다)
  projectedMatchId String?
  projectedAt      DateTime?

  /// 신선도 정책 (`NEXON_REFRESH_INTERVAL_DAYS`, 기본 30일)
  lastVerifiedAt DateTime  @default(now())
  refreshDueAt   DateTime?
  staleAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants NexonMatchParticipant[]
  observations NexonMatchObservation[]

  @@unique([source, sourceMatchId])
  @@index([projectionStatus])
  @@index([validationStatus])
  @@index([refreshDueAt])
  @@index([dateMatch])
  @@index([matchType])
}

/// 넥슨 매치 참가자 스테이징.
///
/// 넥슨은 참가자 ouid를 주지 않는다(닉네임만). 그래서 안정 키는 **응답 배열 순서(slot)** 뿐이다.
/// 결측값은 전부 null이며 기본값으로 채우지 않는다.
model NexonMatchParticipant {
  id           String @id @default(cuid())
  nexonMatchId String
  slot         Int

  teamId      String?
  /// 원본 코드 그대로 (1 승 / 2 패 / 3 무)
  matchResult String?
  /// 해석값 "win" | "lose" | "draw" — 모르면 null
  outcome     String?

  userName    String?
  seasonGrade String?
  /// 클랜전 계열에서만 내려온다
  clanName    String?

  kill     Int?
  death    Int?
  assist   Int?
  headshot Int?
  damage   Float?

  /// 이 기록의 출처. `match_detail` = 상세 응답에서 왔다.
  /// 목록에서 온 개인 관측값은 **여기 넣지 않고** `NexonMatchObservation`에 따로 쌓는다 (D-048).
  source String @default("match_detail")

  /// 닉네임 해석 결과. **모호하면 비워 둔다** (자동 병합 금지)
  resolvedPlayerId String?
  resolvedOuid     String?
  /// "unresolved" | "resolved" | "ambiguous"
  resolutionStatus String @default("unresolved")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nexonMatch NexonMatch @relation(fields: [nexonMatchId], references: [id], onDelete: Cascade)

  @@unique([nexonMatchId, slot])
  @@index([userName])
  @@index([clanName])
  @@index([resolvedPlayerId])
}

/// 매치 목록에서 얻은 **개인 관측값**.
///
/// 넥슨 매치 상세는 참가자 일부만 준다(D-044). 반면 매치 목록은 조회 대상 본인의
/// kill/death/assist와 승패를 준다. 같은 경기를 여러 사람이 조회하면 그 사람들 기록을
/// 모을 수 있다 — **다만 그건 상세가 아니다.** 출처를 섞지 않기 위해 표를 분리한다 (D-048).
///
/// **여기 있는 사람만 저장한다.** 나오지 않은 참가자를 추측해서 만들지 않는다.
model NexonMatchObservation {
  id           String @id @default(cuid())
  nexonMatchId String
  /// 이 관측을 만든 조회 대상 (목록을 부른 계정)
  ouid         String
  /// 관측 시점의 닉네임 스냅샷 (식별자가 아니다)
  userName     String?

  /// 원본 코드 그대로 (1 승 / 2 패 / 3 무)
  matchResult String?
  outcome     String?
  kill        Int?
  death       Int?
  assist      Int?

  /// 출처 표기 — `player_match_list`
  source      String   @default("player_match_list")
  rawImportId String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  nexonMatch NexonMatch @relation(fields: [nexonMatchId], references: [id], onDelete: Cascade)

  @@unique([nexonMatchId, ouid])
  @@index([ouid])
}

/// 계정별 폴링 상태 (Phase 8.1 — adaptive polling).
///
/// 5,000명을 같은 주기로 전수 조회하지 않는다. 새 경기가 나오는 사람은 자주,
/// 조용한 사람은 뜸하게 본다. 주기 숫자는 코드가 아니라 설정에서 온다 (D-049).
model NexonPollState {
  id       String  @id @default(cuid())
  ouid     String  @unique
  /// 참고용. 신원의 권위는 `NexonIdentity`에 있다
  playerId String?

  /// "hot" | "warm" | "cold" | "dormant"
  tier            String @default("hot")
  /// 현재 적용 중인 주기(분). tier 기본값에서 시작하되 실제 적용값을 보존한다
  intervalMinutes Int    @default(60)

  lastPolledAt         DateTime?
  lastSuccessfulPollAt DateTime?
  /// 다음 조회 예정 시각. 큐는 이 값이 지난 대상만 가져간다
  nextPollAt           DateTime  @default(now())
  /// 마지막으로 **새 경기**를 발견한 시각
  lastNewMatchAt       DateTime?

  /// 연속으로 새 경기가 없었던 횟수 — 강등 판단 기준
  consecutiveEmptyPolls Int @default(0)
  /// 최근 창(window) 동안 발견한 새 경기 수
  recentNewMatchCount   Int @default(0)

  /// 사용자가 화면에서 `전적갱신`을 눌렀다. **최우선**으로 올라간다
  manualRefreshRequestedAt DateTime?

  /// "league" = 공식리그 등록 선수 (우선 수집 대상) | "general"
  /// 리그 선수를 먼저 보는 이유: 우리가 완성해야 하는 것은 **리그 경기**이기 때문이다 (D-053)
  priorityClass String @default("general")
  /// 같은 로스터 동료에게서 새 클랜전이 발견돼 앞당겨졌다 (match propagation)
  propagatedAt  DateTime?
  propagationReason String?

  /// "success" | "empty" | "failed" | "blocked"
  lastPollStatus String?
  lastError      String?

  totalPolls       Int @default(0)
  totalNewMatches  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextPollAt])
  @@index([tier, nextPollAt])
  @@index([manualRefreshRequestedAt])
  @@index([playerId])
  @@index([priorityClass, nextPollAt])
}

/// 수집 실행 1회의 호출량 계측 (Phase 8.1 — D 요구사항).
///
/// 5,000명 운영 비용을 **추정이 아니라 숫자로** 계산하기 위한 기록이다.
model NexonPollRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  playersPolled         Int @default(0)
  matchListRequests     Int @default(0)
  uniqueNewMatchIds     Int @default(0)
  duplicateMatchIds     Int @default(0)
  matchDetailRequests   Int @default(0)
  detailSkippedByDedupe Int @default(0)
  emptyPolls            Int @default(0)
  rateLimitedCount      Int @default(0)
  failedPolls           Int @default(0)

  /// 새 경기가 있었던 대상 / 없었던 대상 (평균 호출 수 계산용)
  activePlayersPolled   Int @default(0)
  inactivePlayersPolled Int @default(0)
  requestsForActive     Int @default(0)
  requestsForInactive   Int @default(0)

  migrationVersion String
  note             String?

  @@index([startedAt])
}

/// 경기 시점의 **클랜 소속 근거** (Phase 8.2).
///
/// 넥슨은 참가자의 클랜을 문자열(`guild_name`)로만 주고, 그것도 상세에 나온 사람만 준다.
/// 반면 SACLOUD는 리그 운영자로서 **누가 언제 어느 클랜 소속으로 등록됐는지**를 안다.
/// 그 사실을 기간(from~to)으로 보존해, "이 경기 시각에 이 선수가 이 클랜이었는가"를
/// 문자열 비교가 아니라 **등록 기록**으로 판정한다 (D-052).
///
/// 리그 시스템을 재설계하지 않는다. 판정에 필요한 최소한만 둔다.
model LeagueRosterMembership {
  id           String  @id @default(cuid())
  leagueId     String
  leagueClanId String
  playerId     String
  /// 시즌을 알면 남긴다. 몰라도 기간으로 판정할 수 있다
  seasonId     String?

  /// 소속 시작. **이 시각 이후의 경기부터** 이 클랜 소속으로 본다
  joinedAt DateTime
  /// 소속 종료 (null이면 현재까지)
  leftAt   DateTime?

  /// "manual" | "import" | "seed" | "3rd.supply-clan-players" — 근거의 출처
  source   String  @default("manual")
  /// 이 소속을 **관측한 시각** (D-130). 가입 시각이 아니다 — 공개 출처는 "지금 상태"만 준다
  observedAt DateTime?
  /// "high" | "medium" | "low" — 근거의 강도
  confidence String?
  /// 근거 식별자 (스냅샷 capturedAt 등). 나중에 원본과 대조하기 위한 것이다
  sourceRef  String?
  /// 운영자가 확인했는가. 확인되지 않은 소속은 완전성 판정에 쓰지 않는다
  verified Boolean @default(false)
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league     League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueClan LeagueClan @relation(fields: [leagueClanId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season     Season?    @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@unique([leagueClanId, playerId, joinedAt])
  @@index([playerId, joinedAt])
  @@index([leagueId, joinedAt])
  @@index([leagueClanId])
}

/* ========================================================================== */
/* 8. 래더 설정                                                                */
/* ========================================================================== */

/// 래더 상수. **코드에 하드코딩하지 않는다** (LADDER_IMPLEMENTATION_SPEC 7장).
/// 역추적 조사 결과가 갱신되면 이 설정값만 바꾼다.
///
/// division 조합별로 행을 둔다. `divisionKey` 예: "1v1", "2v2", "1v2", "2v1".
model RatingConfig {
  id       String  @id @default(cuid())
  /// null이면 전역 기본값
  leagueId String?
  divisionKey String

  /// D — 기대승률 분모 (관측 3400)
  expectedScoreDivisor Float @default(3400)
  /// 패배 시 K (div1: 24 / div2: 30)
  loseK                Float
  /// 승리 배수 (div1: 1.15 / div2: 1.00)
  winMultiplier        Float
  /// div1이 div2를 상대할 때 0.6 (div2 측은 1.0).
  /// **0.6의 정확한 내부 적용 위치는 [미확인]** — 조사 후 확정한다.
  crossDivisionMultiplier Float @default(1.0)

  formulaVersion String
  effectiveFrom  DateTime @default(now())

  league League? @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, divisionKey, formulaVersion])
}

/* ========================================================================== */
/* 9. 운영                                                                     */
/* ========================================================================== */

/// 관리자 조치 감사 로그. 되돌릴 수 없는 조치(추방·삭제·시즌 종료)를 남긴다.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetType String
  targetId  String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// 서버 측 rate limit (글쓰기 5분 제한 등, 관측).
/// Redis 도입 전까지 DB로 처리한다. Phase 8에서 Redis로 옮길 수 있다.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
}

/// 병영수첩 BattleLog 원문 (Phase 12 · D-114).
///
/// **원문을 버리지 않는다** (`CLAUDE.md` 3-A 1번). 판정기(classifier)를 고쳐도
/// 외부에 다시 요청하지 않고 여기서 재계산할 수 있어야 한다.
model BarracksRawImport {
  id       String @id @default(cuid())
  source   String @default("nexon_barracks")
  endpoint String
  /// 넥슨 match_id 와 같은 값이다 (= `Match.sourceMatchId`)
  matchKey String
  clanNo   String

  payload     Json
  /// 같은 응답을 여러 번 넣어도 행이 늘지 않게 하는 키
  payloadHash String
  /// "ok" | "error"
  status    String  @default("ok")
  errorCode String?

  fetchedAt DateTime @default(now())
  /// 같은 내용이면 다시 저장하지 않고 이 값만 올린다
  fetchCount Int     @default(1)

  @@unique([matchKey, clanNo, payloadHash])
  @@index([matchKey])
  @@index([fetchedAt])
}

/// 경기 × 선수 무기 판정 근거 (D-114).
///
/// 판정 결과만 남기지 않는다. **왜 그렇게 판정했는지**를 같이 남겨야
/// 나중에 사람이 검증하고, 판정기를 바꿔 다시 계산할 수 있다.
model MatchWeaponEvidence {
  id       String @id @default(cuid())
  matchKey String
  /// 병영수첩 계정 번호. **닉네임이 아니라 이 값이 사람의 키다**
  userNexonSn String
  nickname    String?
  /// 우리 Player와 연결된 경우만. 못 찾으면 null로 두고 근거는 그대로 보존한다
  playerId    String?

  /* --- 신호 --- */
  rifleKills  Int
  sniperKills Int
  /// 응답에 없으면 null. 0으로 채우지 않는다 (모름과 0은 다르다)
  arHits Int?
  srHits Int?

  /* --- 판정 --- */
  /// "rifle" | "sniper" | "unknown"
  classification       String
  classificationReason String
  classifierVersion    String

  source    String   @default("nexon_barracks")
  rawId     String?
  fetchedAt DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([matchKey, userNexonSn])
  @@index([matchKey])
  @@index([playerId])
  @@index([classification])
}
