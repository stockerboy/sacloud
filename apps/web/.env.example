# 개발 환경변수 예시. 실제 값은 `.env.local`에 두며 Git에 커밋하지 않는다.
# 운영 비밀키(넥슨 API 키, SMTP 비밀번호 등)는 절대 저장소에 넣지 않는다.

# ---------------------------------------------------------------------------
# API 모드
#   mock — MSW가 요청을 가로챈다 (Phase 1~6에서 쓰던 방식)
#   live — apps/web/app/api/** 의 실제 Route Handler가 응답한다 (Phase 7)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# 데이터베이스 (packages/db/.env와 같은 값이어야 한다)
#   `pnpm db:start`로 띄우는 로컬 개발 DB 주소다.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://sacloud:sacloud@127.0.0.1:5433/sacloud?schema=public"

# ---------------------------------------------------------------------------
# 세션 서명 키 — 32자 이상. **운영에서는 반드시 새로 생성한다.**
#   생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="개발용-임시-키-32자-이상-실제-운영에서는-교체한다"

# ---------------------------------------------------------------------------
# 넥슨 Open API 키 (Phase 8 전적 수집)
#
#   발급: https://openapi.nexon.com  →  마이 페이지  →  애플리케이션
#   호출: 헤더 `x-nxopen-api-key: <키>`
#
#   **이 값을 저장소에 넣지 않는다.** `.env.local`에만 둔다.
#   채팅·이슈·스크린샷에도 붙여넣지 않는다. 노출되면 즉시 재발급한다.
#
#   `test_` 로 시작하는 키는 테스트용이라 호출 한도가 낮다.
#   실제 수집에는 서비스 키가 필요하다 (한도는 넥슨 콘솔에서 확인).
# ---------------------------------------------------------------------------
NEXON_API_KEY=""

# ---------------------------------------------------------------------------
# 넥슨 수집 파이프라인 설정 (Phase 8)
#
#   NEXON_RATE_LIMIT_PER_SEC   초당 요청 수. 넥슨이 한도 수치를 공개하지 않아
#                              **추측하지 않는다.** 보수적인 값에서 시작하고,
#                              429를 받으면 수집기가 스스로 감속한다.
#   NEXON_MAX_RETRIES          일시 오류(5xx·타임아웃)만 재시도하는 횟수
#   NEXON_REQUEST_TIMEOUT_MS   요청 타임아웃
#   NEXON_REFRESH_INTERVAL_DAYS  신선도 정책(일). 넥슨 이용 조건의 "최소 30일마다 갱신"이
#                              기본값이다. 적용 범위가 완전히 검증되지 않았으므로
#                              코드에 고정하지 않고 이 값으로 조정한다.
#   NEXON_MIGRATION_VERSION    수집 파이프라인 세대. 원본 재변환 시 구분자로 쓴다.
# ---------------------------------------------------------------------------
NEXON_RATE_LIMIT_PER_SEC=2
NEXON_MAX_RETRIES=3
NEXON_REQUEST_TIMEOUT_MS=20000
NEXON_REFRESH_INTERVAL_DAYS=30
NEXON_MIGRATION_VERSION=nexon-v1

# ---------------------------------------------------------------------------
# 적응형 폴링 (Phase 8.1)
#
#   5,000명을 같은 주기로 전수 조회하지 않는다. 새 경기가 나오는 사람은 자주,
#   조용한 사람은 뜸하게 본다. 아래 값은 **임시값**이며 실제 호출 한도를 확인하면 조정한다.
#   "몇 분마다 반드시"를 영구 규칙으로 코드에 박지 않는다 (D-049).
# ---------------------------------------------------------------------------
NEXON_POLL_HOT_MINUTES=30
NEXON_POLL_WARM_MINUTES=180
NEXON_POLL_COLD_MINUTES=1440
NEXON_POLL_DORMANT_MINUTES=10080
NEXON_POLL_EMPTY_TO_WARM=2
NEXON_POLL_EMPTY_TO_COLD=5
NEXON_POLL_EMPTY_TO_DORMANT=10
NEXON_POLL_DORMANT_DAYS=30
NEXON_POLL_FAILURE_BACKOFF=2
# 예정보다 이만큼(분) 밀린 대상은 티어와 무관하게 우선순위를 올린다 (starvation 방지)
NEXON_POLL_STARVATION_MINUTES=1440
