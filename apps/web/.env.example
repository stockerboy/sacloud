# 개발 환경변수 예시. 실제 값은 `.env.local`에 두며 Git에 커밋하지 않는다.
# 운영 비밀키(넥슨 API 키, SMTP 비밀번호 등)는 절대 저장소에 넣지 않는다.

# ---------------------------------------------------------------------------
# API 모드
#   mock — MSW가 요청을 가로챈다 (Phase 1~6에서 쓰던 방식)
#   live — apps/web/app/api/** 의 실제 Route Handler가 응답한다 (Phase 7)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# 데이터베이스 (packages/db/.env와 같은 값이어야 한다)
#   `pnpm db:start`로 띄우는 로컬 개발 DB 주소다.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://sacloud:sacloud@127.0.0.1:5433/sacloud?schema=public"

# ---------------------------------------------------------------------------
# 세션 서명 키 — 32자 이상. **운영에서는 반드시 새로 생성한다.**
#   생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="개발용-임시-키-32자-이상-실제-운영에서는-교체한다"

# ---------------------------------------------------------------------------
# 넥슨 Open API 키 (Phase 8 전적 수집)
#
#   발급: https://openapi.nexon.com  →  마이 페이지  →  애플리케이션
#   호출: 헤더 `x-nxopen-api-key: <키>`
#
#   **이 값을 저장소에 넣지 않는다.** `.env.local`에만 둔다.
#   채팅·이슈·스크린샷에도 붙여넣지 않는다. 노출되면 즉시 재발급한다.
#
#   `test_` 로 시작하는 키는 테스트용이라 호출 한도가 낮다.
#   실제 수집에는 서비스 키가 필요하다 (한도는 넥슨 콘솔에서 확인).
# ---------------------------------------------------------------------------
NEXON_API_KEY=""
